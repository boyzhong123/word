page {
  height: 100%;
  background: #fffdf8;
  color: #101010;
}

.sub-page {
  height: 100%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: #fffdf8;
  font-family: PingFang SC, PingFangSC-Regular, sans-serif;
}

.nav-title {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  pointer-events: none;
}

.sub-scroll {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 18rpx 31rpx 0;
}

.status-card,
.section-card,
.tip-card,
.intro-card {
  background: #ffffff;
  border: 1rpx solid rgba(247, 247, 247, 0.9);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 18rpx rgba(47, 96, 150, 0.045);
}

.intro-card {
  padding: 26rpx 28rpx;
}

.intro-title {
  color: #111318;
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 700;
}

.intro-desc {
  margin-top: 8rpx;
  color: #8b9098;
  font-size: 23rpx;
  line-height: 32rpx;
}

.tmpl-copy {
  flex: 1;
  min-width: 0;
}

.tmpl-count {
  margin-top: 16rpx;
  color: #51545c;
  font-size: 24rpx;
  line-height: 34rpx;
}

.tmpl-count-num {
  margin: 0 4rpx;
  color: #24aa66;
  font-size: 30rpx;
  font-weight: 800;
}

.event-row {
  min-height: 82rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: #f8faf9;
  border-radius: 18rpx;
}

.event-copy {
  flex: 1;
  min-width: 0;
}

.event-label {
  color: #8b9098;
  font-size: 22rpx;
  line-height: 30rpx;
}

.event-when {
  margin-top: 4rpx;
  color: #111318;
  font-size: 24rpx;
  line-height: 34rpx;
}

.event-switch {
  flex: none;
}

.preview-hint {
  min-height: 58rpx;
  margin-top: 16rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #14884f;
  background: #eef9f1;
  border-radius: 18rpx;
  font-size: 23rpx;
  line-height: 32rpx;
  font-weight: 700;
}

.preview-hint-icon {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background-color: #24aa66;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 22rpx 22rpx;
  background-image: url("data:image/svg+xml;base64,");
}

.preview-hint-text {
  flex: 1;
  min-width: 0;
}

.preview-hint-arrow {
  flex: none;
  color: #24aa66;
  font-size: 34rpx;
  line-height: 34rpx;
}

.status-pill-off {
  color: #8b9098;
  background: #eef0f3;
}

.status-card {
  min-height: 128rpx;
  padding: 26rpx;
  display: flex;
  align-items: center;
}

.status-icon {
  flex: none;
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx;
  background-color: #f1fbf3;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 36rpx 36rpx;
}

.status-icon-bell {
  background-image: url("data:image/svg+xml;base64,");
}

.status-copy {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.status-title,
.section-title,
.tip-title {
  color: #111318;
  font-size: 29rpx;
  line-height: 38rpx;
  font-weight: 700;
}

.status-desc,
.section-desc,
.tip-line {
  margin-top: 6rpx;
  color: #8b9098;
  font-size: 23rpx;
  line-height: 32rpx;
}

.status-pill {
  flex: none;
  height: 52rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  color: #24aa66;
  background: #f1fbf3;
  border-radius: 28rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.section-card,
.tip-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.switch-state {
  flex: none;
  color: #51545c;
  font-size: 23rpx;
  font-weight: 700;
}

.primary-btn,
.ghost-btn {
  height: 76rpx;
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 38rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.primary-btn {
  color: #ffffff;
  background: #111318;
}

.primary-btn-disabled {
  color: #8b9098;
  background: #eef0f3;
}

.ghost-btn {
  color: #111318;
  background: #eef0f3;
}

.section-desc-wide {
  margin-top: 10rpx;
}

.scroll-spacer {
  height: 72rpx;
}

.preview-mask {
  position: fixed;
  z-index: 90;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(17, 19, 24, 0.38);
}

.preview-panel {
  width: 100%;
  max-height: 78%;
  padding: 28rpx 31rpx 40rpx;
  box-sizing: border-box;
  background: #f6f7f8;
  border-radius: 30rpx 30rpx 0 0;
}

.preview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.preview-title {
  color: #111318;
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 800;
}

.preview-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b9098;
  font-size: 42rpx;
  line-height: 56rpx;
}

.preview-card {
  margin-top: 22rpx;
  overflow: hidden;
  background: #ffffff;
  border-radius: 18rpx;
  box-shadow: 0 8rpx 18rpx rgba(47, 96, 150, 0.045);
}

.preview-card-title {
  padding: 28rpx 28rpx 18rpx;
  color: #111318;
  font-size: 31rpx;
  line-height: 42rpx;
  font-weight: 700;
}

.preview-field {
  padding: 0 28rpx 16rpx;
  display: flex;
  gap: 26rpx;
}

.preview-field-label {
  flex: none;
  width: 138rpx;
  color: #8b9098;
  font-size: 25rpx;
  line-height: 34rpx;
}

.preview-field-value {
  flex: 1;
  min-width: 0;
  color: #22252b;
  font-size: 25rpx;
  line-height: 34rpx;
}

.preview-card-footer {
  height: 82rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #111318;
  font-size: 26rpx;
  border-top: 1rpx solid #eef0f3;
}

.preview-arrow {
  color: #b8bdc4;
  font-size: 42rpx;
}

.preview-note {
  margin-top: 18rpx;
  color: #8b9098;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}
