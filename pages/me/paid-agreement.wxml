<view class="sub-page">
  <navigation background="#fffdf8">
    <view class="nav-title">用户付费协议</view>
  </navigation>

  <scroll-view class="sub-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="hero-card">
      <view class="hero-copy">
        <view class="hero-title">用户付费协议</view>
        <view class="hero-desc">请在购买前仔细阅读以下条款，重点关注付费方式、有效期、退款说明与责任边界。</view>
        <view class="hero-meta">参考版本：2026 年 6 月 25 日迭代，2026 年 6 月 25 日生效</view>
      </view>
    </view>

    <view class="policy-card" wx:for="{{sections}}" wx:key="title">
      <view class="policy-title">{{item.title}}</view>
      <view wx:for="{{item.lines}}" wx:for-item="line" wx:key="*this" class="policy-line">{{line}}</view>
    </view>

    <view class="tip-card">
      <view class="tip-title">温馨提示</view>
      <view class="tip-desc">购买时请确认产品功能及费用。鉴于产品属性，一旦购买，通常不予退款。</view>
    </view>

    <view class="scroll-spacer"></view>
  </scroll-view>
</view>
