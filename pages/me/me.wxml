<template name="menuInner">
  <view class="menu-icon menu-ic-{{id}}"></view>
  <view class="menu-copy">
    <view class="menu-label">{{label}}</view>
    <view wx:if="{{desc}}" class="menu-desc">{{desc}}</view>
  </view>
  <view wx:if="{{openType}}" class="menu-status menu-status-{{statusType}} menu-status-action">
    <text class="menu-status-text">{{statusText}}</text>
    <button
      plain
      hover-class="none"
      class="menu-status-hit"
      open-type="{{openType}}"
      bindgetphonenumber="handleGetPhoneNumber"
    ></button>
  </view>
  <view wx:elif="{{statusText}}" class="menu-status menu-status-{{statusType}}">{{statusText}}</view>
  <view class="menu-arrow">›</view>
</template>

<view class="me-page">
  <scroll-view class="me-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="profile-header" style="padding-top: {{safeAreaTop}}px;">
      <image class="profile-header-bg" src="{{profileHeaderBg}}" mode="aspectFill" />
      <view class="profile-main">
        <block wx:if="{{logined}}">
          <button class="avatar-wrap avatar-button" open-type="chooseAvatar" bindchooseavatar="handleChooseAvatar">
            <image wx:if="{{userInfo.avatarUrl}}" class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
            <view wx:else class="avatar avatar-empty">👤</view>
          </button>
          <view class="profile-copy">
            <view class="nickname-row">
              <view class="nickname-inline">
                <view class="nickname-edit-wrap">
                  <text class="nickname nickname-ruler">{{userInfo.nickName || '英语学习者'}}</text>
                  <input
                    class="nickname nickname-input"
                    type="nickname"
                    value="{{userInfo.nickName}}"
                    maxlength="16"
                    placeholder="英语学习者"
                    placeholder-style="color: #17406f;"
                    confirm-type="done"
                    bindinput="handleNickNameInput"
                    bindblur="handleNickNameBlur"
                    bindconfirm="handleNickNameBlur"
                  />
                </view>
                <image
                  class="profile-vip-badge"
                  src="{{membership.active ? vipNameBadgeUrl : vipNameBadgeInactiveUrl}}"
                  mode="aspectFit"
                  bindtap="goMembership"
                />
                <text
                  wx:if="{{membership.active}}"
                  class="profile-vip-expire"
                  bindtap="goMembership"
                >会员有效期至 {{membership.expireText}}</text>
              </view>
            </view>
            <view class="profile-sub-chips">
              <block wx:if="{{profileGradeSemester || profileVersion}}">
                <view
                  wx:if="{{profileGradeSemester}}"
                  class="profile-sub-chip"
                  hover-class="profile-sub-chip-hover"
                  hover-stay-time="80"
                  bindtap="editProfile"
                >
                  <text class="profile-sub-chip-text">{{profileGradeSemester}}</text>
                </view>
                <view
                  wx:if="{{profileVersion}}"
                  class="profile-sub-chip"
                  hover-class="profile-sub-chip-hover"
                  hover-stay-time="80"
                  bindtap="editProfile"
                >
                  <text class="profile-sub-chip-text">{{profileVersion}}</text>
                </view>
              </block>
              <view
                wx:else
                class="profile-sub-chip"
                hover-class="profile-sub-chip-hover"
                hover-stay-time="80"
                bindtap="editProfile"
              >
                <text class="profile-sub-chip-text">点击设置年级和教材</text>
              </view>
            </view>
          </view>
        </block>
        <block wx:else>
          <view class="avatar-wrap" bindtap="handleLogin">
            <view class="avatar avatar-empty">👤</view>
          </view>
          <view class="profile-copy" bindtap="handleLogin">
            <view class="nickname">点击登录</view>
            <view class="profile-sub">登录后同步你的学习进度</view>
          </view>
        </block>
      </view>
    </view>

    <view class="checkin-section">
      <view class="checkin-section-head">
        <view class="section-title">学习打卡</view>
        <view class="checkin-section-tagline">坚持打卡，词汇天天涨</view>
      </view>
      <view class="checkin-card">
        <view class="checkin-metrics">
          <view class="checkin-metric metric-streak" bindtap="goCheckinCalendar">
            <view class="metric-icon">
              <image src="../../images/home/icon-checkin-streak-jelly.png" mode="aspectFit" />
            </view>
            <view class="metric-copy">
              <view class="metric-number">{{checkin.continuousDays}}<text>天</text></view>
              <view class="metric-label">连续打卡</view>
            </view>
          </view>
          <view class="checkin-metric" bindtap="goCheckinCalendar">
            <view class="metric-icon">
              <image src="../../images/home/icon-checkin-total-jelly.png" mode="aspectFit" />
            </view>
            <view class="metric-copy">
              <view class="metric-number">{{checkin.totalDays}}<text>天</text></view>
              <view class="metric-label">累计打卡</view>
            </view>
          </view>
          <view class="checkin-metric metric-words" bindtap="goCheckinCalendar">
            <view class="metric-icon">
              <image src="../../images/home/icon-checkin-words-jelly.png" mode="aspectFit" />
            </view>
            <view class="metric-copy">
              <view class="metric-number">{{stats.learnedWords}}</view>
              <view class="metric-label">累计学词</view>
            </view>
          </view>
          <view class="checkin-metric metric-minutes" bindtap="goCheckinCalendar">
            <view class="metric-icon">
              <image src="../../images/home/icon-checkin-minutes-jelly.png" mode="aspectFit" />
            </view>
            <view class="metric-copy">
              <view class="metric-number">{{stats.studyMinutes}}</view>
              <view class="metric-label">学习分钟</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="message-section">
      <view class="section-title">消息与关注</view>
      <view class="message-card">
        <view class="message-row" bindtap="openSubscribeCenter">
          <view class="message-row-icon message-row-icon-remind"></view>
          <view class="message-row-copy">
            <view class="message-row-title">开启学习提醒</view>
            <view class="message-row-desc">复习、错题和练习结果通知</view>
          </view>
          <view class="message-row-action">去开启</view>
        </view>
        <view class="message-divider"></view>
        <view class="message-row message-row-official" bindtap="openOfficialAccount">
          <view class="message-row-icon message-row-icon-official">号</view>
          <view class="message-row-copy">
            <view class="message-row-title">关注公众号，领取学习资料</view>
            <view class="message-row-desc">资料领取与学习内容更新</view>
          </view>
          <view class="message-row-action message-row-action-{{officialAccountStatusType}}">{{officialAccountStatusText}}</view>
        </view>
      </view>
    </view>

    <view class="menu-section menu-section-tight">
      <view class="section-title">常用</view>
      <view class="menu-group">
        <view
          class="menu-item"
          data-url="/pages/study-record/record"
          bindtap="handleMenuTap"
        >
          <view class="menu-icon menu-ic-record"></view>
          <view class="menu-copy">
            <view class="menu-label">学习记录</view>
            <view class="menu-desc">查看学习周期与每天记录</view>
          </view>
          <view class="menu-arrow">›</view>
        </view>
        <view
          class="menu-item"
          wx:for="{{menus}}"
          wx:key="id"
          data-action="{{item.action}}"
          data-url="{{item.url}}"
          bindtap="handleMenuTap"
        >
          <template is="menuInner" data="{{...item}}" />
          <button
            wx:if="{{item.openType}}"
            class="contact-hit"
            data-action="{{item.action}}"
            catchtap="onContact"
          ></button>
        </view>
      </view>
    </view>

    <view class="menu-section">
      <view class="section-title">账号设置</view>
      <view class="menu-group">
        <block wx:for="{{settings}}" wx:key="id">
          <view wx:if="{{item.id === 'gender'}}" class="menu-item menu-item-gender">
            <view class="menu-icon menu-ic-gender"></view>
            <view class="menu-copy">
              <view class="menu-label">{{item.label}}</view>
              <view wx:if="{{item.desc}}" class="menu-desc">{{item.desc}}</view>
            </view>
            <view class="gender-switch">
              <view
                class="gender-option {{characterGender === 'boy' ? 'gender-option-active' : ''}}"
                data-gender="boy"
                bindtap="handleGenderSelect"
              >男孩</view>
              <view
                class="gender-option {{characterGender === 'girl' ? 'gender-option-active' : ''}}"
                data-gender="girl"
                bindtap="handleGenderSelect"
              >女孩</view>
            </view>
          </view>
          <view wx:elif="{{item.openType}}" class="menu-item">
            <template is="menuInner" data="{{...item}}" />
          </view>
          <view
            wx:else
            class="menu-item"
            data-action="{{item.action}}"
            data-url="{{item.url}}"
            bindtap="handleMenuTap"
          >
            <template is="menuInner" data="{{...item}}" />
          </view>
        </block>
      </view>
    </view>

    <view class="scroll-spacer"></view>
  </scroll-view>
</view>
