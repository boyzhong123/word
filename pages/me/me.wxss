page {
  height: 100%;
  background: #fffdf8;
  color: #101010;
}

.me-page {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #fffdf8;
  font-family: PingFang SC, PingFangSC-Regular, sans-serif;
}

.me-scroll {
  width: 100%;
  height: 100%;
}

/* ---------- header ---------- */
.profile-header {
  position: relative;
  padding: 0 31rpx 34rpx;
  overflow: hidden;
  border-radius: 0 0 34rpx 34rpx;
}

.profile-header-bg {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.profile-main {
  position: relative;
  z-index: 1;
  min-height: 164rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.avatar-wrap {
  flex: 0 0 108rpx;
  width: 108rpx;
  max-width: 108rpx;
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-button {
  flex: 0 0 108rpx;
  width: 108rpx;
  max-width: 108rpx;
  height: 108rpx;
  margin: 0;
  padding: 0;
  overflow: visible;
  line-height: 1;
  background: transparent;
  border-radius: 50%;
  box-sizing: border-box;
}

.avatar-button::after {
  border: none;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  box-sizing: border-box;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 8rpx 18rpx rgba(23, 64, 111, 0.14);
}

.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.72);
  font-size: 54rpx;
}

.profile-copy {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.nickname-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.nickname-inline {
  display: inline-flex;
  align-items: center;
  flex-wrap: wrap;
  max-width: 100%;
}

.nickname-edit-wrap {
  position: relative;
  display: inline-block;
  max-width: 100%;
  flex: 0 1 auto;
  min-width: 0;
}

.nickname-ruler {
  display: inline-block;
  visibility: hidden;
  max-width: 100%;
  min-height: 40rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 700;
  white-space: pre;
  box-sizing: border-box;
}

.nickname {
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 700;
  color: #17406f;
  text-shadow: 0 4rpx 10rpx rgba(255, 255, 255, 0.72);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-vip-badge {
  flex-shrink: 0;
  width: 112rpx;
  height: 44rpx;
  margin-left: 6rpx;
  margin-top: -7rpx;
  align-self: center;
}

.profile-vip-expire {
  flex-shrink: 0;
  margin-left: 10rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  font-weight: 500;
  color: rgba(23, 64, 111, 0.82);
  text-shadow: 0 3rpx 8rpx rgba(255, 255, 255, 0.78);
}

.nickname-input {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 40rpx;
  min-height: 40rpx;
  padding: 0;
  text-align: left;
  background: transparent;
  border: none;
  box-sizing: border-box;
}

.profile-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #111318;
  text-shadow: 0 3rpx 8rpx rgba(255, 255, 255, 0.78);
}

.profile-sub-chips {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 6rpx;
  max-width: 100%;
}

.profile-sub-chip {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1.5rpx solid rgba(23, 64, 111, 0.2);
  box-shadow: 0 4rpx 14rpx rgba(23, 64, 111, 0.1);
  box-sizing: border-box;
}

.profile-sub-chip-hover {
  background: rgba(255, 255, 255, 0.98);
  border-color: rgba(23, 64, 111, 0.32);
  box-shadow: 0 6rpx 16rpx rgba(23, 64, 111, 0.14);
}

.profile-sub-chip-text {
  max-width: 320rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 600;
  color: #17406f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- check-in card ---------- */
.checkin-section {
  padding: 24rpx 31rpx 0;
}

.checkin-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 17rpx;
}

.checkin-section-head .section-title {
  margin-bottom: 0;
}

.checkin-section-tagline {
  flex: none;
  color: #0f9b4e;
  font-size: 22rpx;
  line-height: 32rpx;
  font-weight: 600;
}

.checkin-card {
  padding: 22rpx 24rpx 20rpx;
  background: #ffffff;
  border: 1rpx solid #eef1ef;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 22rpx rgba(16, 54, 31, 0.06);
}

.checkin-metrics {
  margin-top: 0;
  padding: 4rpx 0 0;
  box-sizing: border-box;
  display: flex;
  align-items: stretch;
}

.checkin-metric {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 0 2rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border-radius: 14rpx;
}

.checkin-metric:active {
  background: rgba(234, 244, 255, 0.72);
}

.checkin-metric .metric-icon {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkin-metric .metric-icon image {
  width: 44rpx;
  height: 44rpx;
}

.checkin-metric.metric-words .metric-icon,
.checkin-metric.metric-minutes .metric-icon {
  width: 56rpx;
  height: 56rpx;
}

.checkin-metric.metric-words .metric-icon image,
.checkin-metric.metric-minutes .metric-icon image {
  width: 56rpx;
  height: 56rpx;
}

.checkin-metric .metric-copy {
  flex: none;
  min-width: 0;
  text-align: center;
}

.checkin-metric .metric-number {
  color: #101010;
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 800;
  white-space: nowrap;
}

.checkin-metric .metric-number text {
  margin-left: 1rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.checkin-metric .metric-label {
  margin-top: 2rpx;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 32rpx;
  white-space: nowrap;
}

.checkin-metric.metric-streak .metric-number {
  color: #7c3aed;
}

.checkin-metric.metric-words .metric-number {
  color: #0f9b4e;
}

.checkin-metric.metric-minutes .metric-number {
  color: #0284c7;
}

/* ---------- menu ---------- */
.message-section {
  padding: 36rpx 31rpx 0;
}

.menu-section {
  padding: 26rpx 31rpx 0;
}

.menu-section-tight {
  padding-top: 28rpx;
}

.section-title {
  margin: 0 0 17rpx 4rpx;
  color: #51545c;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 700;
}

.menu-group {
  background: #ffffff;
  border: 1rpx solid rgba(247, 247, 247, 0.9);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 18rpx rgba(47, 96, 150, 0.045);
  overflow: hidden;
}

/* ---------- message and official account ---------- */
.message-card {
  background: #ffffff;
  border: 1rpx solid rgba(247, 247, 247, 0.9);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 18rpx rgba(47, 96, 150, 0.045);
  overflow: hidden;
}

.message-row {
  min-height: 112rpx;
  padding: 22rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.message-row-official {
  padding-bottom: 18rpx;
}

.message-row-icon {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 34rpx 34rpx;
}

.message-row-icon-remind {
  background-color: #f1fbf3;
  background-image: url("data:image/svg+xml;base64,");
}

.message-row-icon-official {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7a5200;
  font-size: 22rpx;
  font-weight: 800;
  background: #fff4d6;
}

.message-row-copy {
  flex: 1;
  min-width: 0;
}

.message-row-title {
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 500;
  color: #1a1a1a;
}

.message-row-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  color: #8b9098;
}

.message-row-action {
  flex: none;
  height: 52rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  background: #111318;
  border-radius: 28rpx;
}

.message-row-action-followed {
  color: #24aa66;
  background: #f1fbf3;
}

.message-row-action-pending {
  color: #ffffff;
  background: #111318;
}

.message-divider {
  height: 1rpx;
  margin-left: 102rpx;
  background: #f2f2f2;
}

.menu-item {
  position: relative;
  height: 112rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
}

.menu-item::after {
  content: '';
  position: absolute;
  left: 106rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: #f2f2f2;
}

.menu-item:last-child::after {
  display: none;
}

.contact-hit {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  background: transparent;
  opacity: 0;
}

.contact-hit::after {
  border: none;
}

.menu-status-action {
  position: relative;
  overflow: hidden;
}

.menu-status-text {
  font-size: 22rpx;
  line-height: 42rpx;
  font-weight: 700;
}

.menu-status-hit {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  min-width: 0;
  min-height: 0;
  line-height: 1;
  opacity: 0;
  border: 0;
  background: transparent;
}

.menu-status-hit::after {
  border: 0;
}

.menu-icon {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  margin-right: 24rpx;
  border-radius: 18rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 34rpx 34rpx;
}

.menu-ic-record {
  background-color: #f1fbf3;
  background-image: url("data:image/svg+xml;base64,");
}

.menu-ic-book {
  background-color: #e8f1ff;
  background-image: url("data:image/svg+xml;base64,");
}

.menu-ic-notify {
  background-color: #f1fbf3;
  background-image: url("data:image/svg+xml;base64,");
}

.menu-ic-contact {
  background-color: #eef0f3;
  background-image: url("data:image/svg+xml;base64,");
}

.menu-ic-phone {
  background-color: #eaf8ff;
  background-image: url("data:image/svg+xml;base64,");
}

.menu-ic-privacy {
  background-color: #eef0f3;
  background-image: url("data:image/svg+xml;base64,");
}

.menu-ic-gender {
  background-color: #fff0f6;
  background-image: url("data:image/svg+xml;base64,");
}

.menu-item-gender::after {
  left: 106rpx;
}

.gender-switch {
  flex: none;
  display: flex;
  align-items: center;
  padding: 4rpx;
  border-radius: 999rpx;
  background: #f3f5f8;
}

.gender-option {
  min-width: 88rpx;
  height: 52rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 52rpx;
  font-weight: 600;
}

.gender-option-active {
  color: #17406f;
  background: #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(23, 64, 111, 0.08);
}

.menu-copy {
  flex: 1;
  min-width: 0;
}

.menu-label {
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 500;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-desc {
  margin-top: 4rpx;
  color: #8b9098;
  font-size: 22rpx;
  line-height: 30rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-status {
  flex: none;
  height: 42rpx;
  margin-left: 16rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  font-size: 22rpx;
  line-height: 42rpx;
  font-weight: 700;
  white-space: nowrap;
}

.menu-status-pending {
  color: #2f7ff0;
  background: #eaf3ff;
}

.menu-status-verified {
  color: #1f8f50;
  background: #eaf8ef;
}

.menu-arrow {
  flex: none;
  margin-left: 10rpx;
  color: #c4c4c4;
  font-size: 28rpx;
  line-height: 28rpx;
}

.scroll-spacer {
  /* 102rpx = 自定义 tabBar 主体高度，避免「隐私与协议」被底栏遮挡 */
  height: calc(102rpx + 36rpx + env(safe-area-inset-bottom));
}

.me-page-vip-floating .scroll-spacer {
  height: calc(102rpx + 156rpx + env(safe-area-inset-bottom));
}

.vip-floating-guide {
  position: fixed;
  left: 0;
  right: 0;
  width: auto;
  bottom: calc(102rpx + env(safe-area-inset-bottom));
  z-index: 110;
  margin: 0;
  padding: 0;
  font-size: 0;
  line-height: 0;
  background: transparent;
  overflow: hidden;
  border-radius: 20rpx 20rpx 0 0;
}

.vip-floating-guide:active {
  transform: none;
}

.vip-floating-banner {
  display: block;
  width: 100%;
  margin: 0;
  padding: 0;
  opacity: 1;
  vertical-align: top;
}

.vip-floating-close-hit {
  position: absolute;
  top: 0;
  right: 0;
  width: 98rpx;
  height: 92rpx;
}
