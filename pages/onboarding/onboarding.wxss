/* pages/onboarding/onboarding.wxss */
.page {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #e7e1f0 0%, #dadcf4 28%, #bcd0f8 50%, #97bdf6 72%, #78acf4 100%);
}

.onboard-nav {
  position: relative;
  flex-shrink: 0;
}

.onboard-back-btn {
  position: absolute;
  left: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 4rpx 14rpx rgba(17, 19, 24, 0.1);
}

.onboard-back-btn-hover {
  opacity: 0.72;
}

.onboard-back-icon {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #111318;
  border-bottom: 4rpx solid #111318;
  border-radius: 1rpx;
  transform: translateX(3rpx) rotate(45deg);
}

.onboard-scroll {
  flex: 1;
  height: 0;
}

.onboard-panel {
  /* padding-top 由 JS 按状态栏 + 胶囊高度内联注入，让出自定义导航区 */
  padding: 0 40rpx 32rpx;
}

.onboard-step-banner {
  position: relative;
  width: 100%;
  height: 300rpx;
  margin: 0 0 24rpx;
  overflow: hidden;
  border-radius: 36rpx;
  box-shadow: 0 24rpx 48rpx rgba(49, 72, 61, 0.12);
}

.onboard-step-banner--form {
  height: 220rpx;
}

.onboard-step-banner--intro {
  height: 400rpx;
  margin-bottom: 0;
}

.onboard-step-banner-img {
  display: block;
  width: 100%;
  height: 100%;
}

.onboard-step-banner--intro .onboard-step-banner-img {
  /* 横幅为横图 aspectFill，锚定偏下以露出果冻 mascot，避免只裁到天空 */
  object-position: 50% 68%;
}

.onboard-step-banner-fade {
  position: absolute;
  z-index: 1;
  left: 0;
  right: 0;
  bottom: 0;
  height: 88rpx;
  background: linear-gradient(180deg, rgba(231, 225, 240, 0) 0%, rgba(218, 220, 244, 0.72) 68%, rgba(231, 225, 240, 0.92) 100%);
  pointer-events: none;
}

.onboard-step-badge {
  position: absolute;
  top: 22rpx;
  left: 22rpx;
  z-index: 2;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  color: #375041;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(51, 74, 60, 0.12);
}

.onboard-intro-card {
  position: relative;
  z-index: 2;
  margin-top: 16rpx;
  padding: 28rpx 28rpx 30rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(233, 239, 236, 0.96);
  box-shadow: 0 18rpx 40rpx rgba(29, 39, 45, 0.08);
}

.onboard-intro-brand {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.onboard-intro-copy {
  flex: 1;
  min-width: 0;
}

.onboard-app-name {
  font-size: 26rpx;
  font-weight: 800;
  color: #5b6b61;
  line-height: 1.25;
}

.onboard-intro-title {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #16211b;
  line-height: 1.3;
}

.onboard-intro-sub {
  margin-top: 20rpx;
}

.onboard-logo {
  width: 104rpx;
  height: 104rpx;
  flex-shrink: 0;
  border-radius: 26rpx;
  box-shadow: 0 16rpx 30rpx rgba(17, 19, 24, 0.12);
}

.onboard-highlights-card {
  margin-top: 24rpx;
  padding: 26rpx 24rpx 10rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(233, 239, 236, 0.96);
  box-shadow: 0 18rpx 40rpx rgba(29, 39, 45, 0.08);
}

.onboard-highlights-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 8rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #eef2f0;
}

.onboard-highlights-badge {
  flex-shrink: 0;
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #e8fff0 0%, #d2f7df 100%);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.72);
}

.onboard-highlights-badge-icon {
  width: 52rpx;
  height: 52rpx;
}

.onboard-highlights-head-copy {
  flex: 1;
  min-width: 0;
}

.onboard-highlights-kicker {
  font-size: 22rpx;
  font-weight: 700;
  color: #1f8e4c;
  line-height: 1.3;
}

.onboard-highlights-title {
  margin-top: 6rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #16211b;
  line-height: 1.35;
}

.onboard-features {
  display: flex;
  flex-direction: column;
}

.onboard-feature-card {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.onboard-feature-card:last-child {
  border-bottom: none;
}

.onboard-feature-badge {
  flex-shrink: 0;
  width: 78rpx;
  height: 78rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.72);
}

.onboard-feature-badge-inner {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.84);
}

.onboard-feature-icon {
  width: 38rpx;
  height: 38rpx;
}

.onboard-feature-copy {
  flex: 1;
  min-width: 0;
}

.onboard-feature-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.onboard-feature-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a2029;
  line-height: 1.35;
}

.onboard-feature-tag {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #eaf8ef;
  color: #24a957;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 28rpx;
}

.onboard-feature-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #8b96a3;
}

.onboard-feature-card--0 .onboard-feature-badge {
  background: linear-gradient(180deg, #fff3dd 0%, #ffe5c3 100%);
}

.onboard-feature-card--0 .onboard-feature-badge-inner {
  box-shadow: 0 8rpx 18rpx rgba(255, 157, 45, 0.14);
}

.onboard-feature-card--1 .onboard-feature-badge {
  background: linear-gradient(180deg, #f3ebff 0%, #e8d8ff 100%);
}

.onboard-feature-card--1 .onboard-feature-badge-inner {
  box-shadow: 0 8rpx 18rpx rgba(140, 100, 255, 0.13);
}

.onboard-feature-card--2 .onboard-feature-badge {
  background: linear-gradient(180deg, #e8fff0 0%, #d2f7df 100%);
}

.onboard-feature-card--2 .onboard-feature-badge-inner {
  box-shadow: 0 8rpx 18rpx rgba(60, 196, 110, 0.12);
}

.onboard-feature-card--3 .onboard-feature-badge {
  background: linear-gradient(180deg, #e9f5ff 0%, #d7eaff 100%);
}

.onboard-feature-card--3 .onboard-feature-badge-inner {
  box-shadow: 0 8rpx 18rpx rgba(82, 153, 242, 0.12);
}

.onboard-intro-points {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.onboard-intro-point {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #f3fff6 0%, #ebfff1 100%);
  border: 1rpx solid #d9f3df;
  color: #1f8e4c;
  font-size: 22rpx;
  font-weight: 700;
}

.onboard-start-tip {
  margin-top: 22rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 600;
  color: #3f5f7c;
}

.onboard-head {
  margin-bottom: 20rpx;
}

.onboard-kicker {
  display: inline-flex;
  align-items: center;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #5c6b63;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 16rpx rgba(17, 19, 24, 0.05);
}

.onboard-title {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #16211b;
  line-height: 1.3;
}

.onboard-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.5;
  color: #67756e;
}

.onboard-steps {
  display: flex;
  align-items: center;
  margin: 4rpx 0 20rpx;
}

.onboard-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
  color: #93a09a;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 1rpx rgba(225, 232, 227, 0.96);
}

.onboard-dot.on {
  background: linear-gradient(180deg, #20262c 0%, #111318 100%);
  color: #fff;
  box-shadow: none;
}

.onboard-line {
  flex: 1;
  height: 6rpx;
  background: #e5ebe7;
  margin: 0 8rpx;
  border-radius: 3rpx;
}

.onboard-line.on {
  background: linear-gradient(90deg, #2ccb6a 0%, #1aa85a 100%);
}

.onboard-body {
  padding-bottom: 12rpx;
}

.onboard-form-card {
  padding: 28rpx 28rpx 10rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(233, 239, 236, 0.96);
  box-shadow: 0 18rpx 40rpx rgba(29, 39, 45, 0.08);
}

.onboard-section {
  margin-bottom: 28rpx;
}

.onboard-section--phone {
  margin-bottom: 8rpx;
}

.onboard-section-label {
  margin-bottom: 14rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #16211b;
}

.onboard-hint {
  margin-bottom: 14rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #8a8f99;
}

.onboard-tip {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.45;
  color: #8a8f99;
}

.stage-row {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: rgba(17, 19, 24, 0.05);
}

.stage-chip {
  flex: 1;
  height: 64rpx;
  border-radius: 18rpx;
  background: transparent;
  border: none;
  color: #667085;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-shadow: none;
}

.stage-chip.sel {
  background: #ffffff;
  border: none;
  color: #16211b;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(17, 19, 24, 0.08);
}

.grade-picker-panel {
  padding: 20rpx 18rpx 8rpx;
  border-radius: 24rpx;
  background: rgba(120, 172, 244, 0.08);
  border: 1rpx solid rgba(120, 172, 244, 0.16);
}

.grade-picker-hint {
  margin-bottom: 14rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #5a7394;
}

.grade-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.grade-chip,
.version-chip,
.semester-chip,
.gender-chip {
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #fbfcfc;
  border: 1rpx solid #e7ece9;
  color: #1c2721;
  font-size: 28rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-shadow: inset 0 -4rpx 12rpx rgba(255, 255, 255, 0.4);
}

.grade-chip {
  width: calc((100% - 32rpx) / 3);
  height: 88rpx;
}

.semester-inline {
  display: flex;
  gap: 16rpx;
}

.semester-chip {
  flex: 1;
  min-height: 88rpx;
  padding: 14rpx 16rpx;
  flex-direction: column;
  gap: 4rpx;
}

.semester-chip-name {
  font-size: 28rpx;
  font-weight: 400;
  color: inherit;
  line-height: 1.2;
}

.semester-chip-tag {
  font-size: 22rpx;
  font-weight: 400;
  color: #8a8f99;
  line-height: 1.2;
}

.version-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.version-chip {
  width: calc((100% - 16rpx) / 2);
  min-height: 88rpx;
  padding: 0 20rpx;
}

.gender-row {
  display: flex;
  gap: 16rpx;
}

.gender-chip {
  flex: 1;
  height: 88rpx;
}

.grade-chip.sel,
.version-chip.sel,
.semester-chip.sel,
.gender-chip.sel {
  background: linear-gradient(135deg, #1ed067 0%, #17b65a 100%);
  border-color: #17b65a;
  color: #fff;
  font-weight: 500;
  box-shadow: 0 12rpx 24rpx rgba(23, 182, 90, 0.2);
}

.semester-chip.sel .semester-chip-name,
.semester-chip.sel .semester-chip-tag {
  color: #fff;
}

.semester-chip.sel .semester-chip-tag {
  color: rgba(255, 255, 255, 0.72);
}

.phone-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 28rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid #edf1ef;
}

.phone-card-copy {
  width: 100%;
}

.phone-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #16211b;
  line-height: 1.35;
}

.phone-card-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.5;
  color: #8a8f99;
}

.phone-card-status {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #1f7a4d;
  font-weight: 600;
  line-height: 1.4;
}

.phone-card-action {
  margin-top: 24rpx;
}

.phone-auth-btn {
  width: 100%;
  margin: 0;
  padding: 0;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx !important;
  border: none !important;
  background: linear-gradient(135deg, #1ed067 0%, #17b65a 100%) !important;
  color: #ffffff !important;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 18rpx rgba(23, 182, 90, 0.18);
}

.phone-auth-done {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 80rpx;
  border-radius: 999rpx;
  background: rgba(31, 122, 77, 0.08);
  font-size: 28rpx;
  color: #1f7a4d;
  font-weight: 700;
}

.onboard-footer {
  flex-shrink: 0;
  padding: 16rpx 40rpx calc(16rpx + env(safe-area-inset-bottom));
  background: transparent;
}

.onboard-next {
  width: 100%;
  height: 96rpx;
  font-size: 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #171b20 0%, #0f1114 100%);
  box-shadow: 0 16rpx 28rpx rgba(17, 19, 24, 0.18);
}

.onboard-skip-link {
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 1.4;
  font-weight: 600;
  color: #3f5f7c;
}
