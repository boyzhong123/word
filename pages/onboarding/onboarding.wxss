/* pages/onboarding/onboarding.wxss */
.page {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #e7e1f0 0%, #dadcf4 28%, #bcd0f8 50%, #97bdf6 72%, #78acf4 100%);
}

.onboard-nav {
  position: relative;
  flex-shrink: 0;
}

.onboard-nav-title-wrap {
  position: absolute;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.onboard-nav-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #16211b;
  letter-spacing: 1rpx;
}

.onboard-back-btn {
  position: absolute;
  left: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 4rpx 14rpx rgba(17, 19, 24, 0.1);
}

.onboard-back-btn-hover {
  opacity: 0.72;
}

.onboard-back-icon {
  width: 14rpx;
  height: 14rpx;
  border-left: 3rpx solid #111318;
  border-bottom: 3rpx solid #111318;
  border-radius: 1rpx;
  transform: translateX(2rpx) rotate(45deg);
}

.onboard-scroll {
  flex: 1;
  height: 0;
}

.onboard-panel {
  /* padding-top 由 JS 按状态栏 + 胶囊高度内联注入，让出自定义导航区 */
  padding: 0 40rpx 32rpx;
}

.onboard-panel-stack {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin: 0 -8rpx;
}

.onboard-panel-img {
  display: block;
  width: 100%;
  border-radius: 28rpx;
  overflow: hidden;
}

.onboard-panel-img + .onboard-panel-img {
  margin-top: 16rpx;
}

.onboard-step-banner {
  position: relative;
  width: 100%;
  height: 300rpx;
  margin: 0 0 24rpx;
  overflow: hidden;
  border-radius: 36rpx;
  box-shadow: 0 24rpx 48rpx rgba(49, 72, 61, 0.12);
}

.onboard-step-banner--form {
  height: 220rpx;
}

.onboard-step-banner--intro {
  height: 400rpx;
  margin-bottom: 0;
}

.onboard-step-banner-img {
  display: block;
  width: 100%;
  height: 100%;
}

.onboard-step-banner--intro .onboard-step-banner-img {
  /* 横图 aspectFill：左侧为合成怪兽，右侧为听读背测图标弧 */
  object-position: 48% 56%;
}

.onboard-step-banner-fade {
  position: absolute;
  z-index: 1;
  left: 0;
  right: 0;
  bottom: 0;
  height: 88rpx;
  background: linear-gradient(180deg, rgba(231, 225, 240, 0) 0%, rgba(218, 220, 244, 0.72) 68%, rgba(231, 225, 240, 0.92) 100%);
  pointer-events: none;
}

.onboard-step-badge {
  position: absolute;
  top: 22rpx;
  left: 22rpx;
  z-index: 2;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  color: #375041;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(51, 74, 60, 0.12);
}

.onboard-intro-card {
  position: relative;
  z-index: 2;
  margin-top: 16rpx;
  padding: 30rpx 28rpx 28rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(233, 239, 236, 0.96);
  box-shadow: 0 18rpx 40rpx rgba(29, 39, 45, 0.08);
}

.onboard-intro-mascot {
  position: absolute;
  right: -10rpx;
  bottom: -16rpx;
  z-index: 1;
  width: 196rpx;
  height: 196rpx;
  opacity: 0.96;
  pointer-events: none;
}

.onboard-intro-brand {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.onboard-intro-copy {
  flex: 1;
  min-width: 0;
}

.onboard-app-name {
  font-size: 26rpx;
  font-weight: 800;
  color: #5b6b61;
  line-height: 1.25;
}

.onboard-intro-title {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #16211b;
  line-height: 1.25;
}

.onboard-intro-title-em {
  margin-top: 4rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #17b65a;
  line-height: 1.25;
  letter-spacing: 1rpx;
}

.onboard-intro-sub {
  position: relative;
  z-index: 2;
  margin-top: 18rpx;
  max-width: 460rpx;
}

.onboard-logo {
  width: 104rpx;
  height: 104rpx;
  flex-shrink: 0;
  border-radius: 26rpx;
  box-shadow: 0 16rpx 30rpx rgba(17, 19, 24, 0.12);
}

.onboard-bridge {
  margin-top: 20rpx;
  text-align: center;
}

.onboard-bridge-line {
  font-size: 24rpx;
  font-weight: 800;
  color: #1f8e4c;
  letter-spacing: 1rpx;
}

.onboard-bridge-arrow {
  margin-top: 4rpx;
  font-size: 26rpx;
  line-height: 1;
  color: #9fc7ad;
}

.onboard-highlights-card {
  margin-top: 12rpx;
  padding: 26rpx 24rpx 10rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(233, 239, 236, 0.96);
  box-shadow: 0 18rpx 40rpx rgba(29, 39, 45, 0.08);
}

.onboard-highlights-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.onboard-highlights-kicker {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: #1f8e4c;
  line-height: 1.3;
}

.onboard-highlights-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #16211b;
  line-height: 1.35;
}

.onboard-features {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.onboard-feature-card {
  box-sizing: border-box;
  width: calc((100% - 16rpx) / 2);
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 18rpx;
  border-radius: 24rpx;
  border: 1rpx solid #eef2f0;
}

.onboard-feature-badge {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.72);
}

.onboard-feature-icon {
  width: 42rpx;
  height: 42rpx;
}

.onboard-feature-copy {
  flex: 1;
  min-width: 0;
}

.onboard-feature-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.onboard-feature-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #16211b;
  line-height: 1.2;
}

.onboard-feature-tag {
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #eaf8ef;
  color: #24a957;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 28rpx;
}

.onboard-feature-desc {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.25;
  color: #8b96a3;
}

.onboard-feature-card--0 {
  background: #fffaf0;
}

.onboard-feature-card--0 .onboard-feature-badge {
  background: linear-gradient(180deg, #fff3dd 0%, #ffe5c3 100%);
}

.onboard-feature-card--1 {
  background: #faf7ff;
}

.onboard-feature-card--1 .onboard-feature-badge {
  background: linear-gradient(180deg, #f3ebff 0%, #e8d8ff 100%);
}

.onboard-feature-card--2 {
  background: #f3fff7;
}

.onboard-feature-card--2 .onboard-feature-badge {
  background: linear-gradient(180deg, #e8fff0 0%, #d2f7df 100%);
}

.onboard-feature-card--3 {
  background: #f4faff;
}

.onboard-feature-card--3 .onboard-feature-badge {
  background: linear-gradient(180deg, #e9f5ff 0%, #d7eaff 100%);
}

.onboard-proof-row {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}

.onboard-proof {
  flex: 1;
  padding: 14rpx 8rpx 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #f3fff6 0%, #ebfff1 100%);
  border: 1rpx solid #d9f3df;
  text-align: center;
}

.onboard-proof-icon {
  width: 56rpx;
  height: 56rpx;
  display: block;
  margin: 0 auto 8rpx;
}

.onboard-proof-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #16211b;
  line-height: 1.2;
}

.onboard-proof-desc {
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #1f8e4c;
  line-height: 1.2;
}

.onboard-pain-card {
  margin-top: 24rpx;
  padding: 26rpx 24rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(233, 239, 236, 0.96);
  box-shadow: 0 18rpx 40rpx rgba(29, 39, 45, 0.08);
}

.onboard-pain-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.onboard-pain-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #16211b;
  line-height: 1.3;
}

.onboard-pain-sub {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: #9aa6a0;
}

.onboard-pain-grid {
  display: flex;
  gap: 16rpx;
}

.onboard-pain {
  flex: 1;
  box-sizing: border-box;
  padding: 18rpx 10rpx 16rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #fffdf8 0%, #f8f6ef 100%);
  border: 1rpx solid #ece6d8;
  text-align: center;
}

.onboard-pain-icon {
  width: 104rpx;
  height: 104rpx;
  display: block;
  margin: 0 auto;
}

.onboard-pain-text {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #5e6d7a;
}

.onboard-start-tip {
  margin-top: 22rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 600;
  color: #3f5f7c;
}

.onboard-head {
  margin-bottom: 20rpx;
}

.onboard-head--intro {
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.onboard-head--intro .onboard-title {
  margin-top: 12rpx;
  font-size: 36rpx;
}

.onboard-kicker {
  display: inline-flex;
  align-items: center;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  color: #3560b8;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 14rpx rgba(72, 108, 180, 0.1);
}

.onboard-title {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #141c30;
  line-height: 1.3;
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.35);
}

.onboard-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.5;
  color: #4a5d82;
}

.onboard-steps {
  display: flex;
  align-items: center;
  margin: 4rpx 0 20rpx;
}

.onboard-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
  color: #93a09a;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 1rpx rgba(225, 232, 227, 0.96);
}

.onboard-dot.on {
  background: linear-gradient(180deg, #20262c 0%, #111318 100%);
  color: #fff;
  box-shadow: none;
}

.onboard-line {
  flex: 1;
  height: 6rpx;
  background: #e5ebe7;
  margin: 0 8rpx;
  border-radius: 3rpx;
}

.onboard-line.on {
  background: linear-gradient(90deg, #2ccb6a 0%, #1aa85a 100%);
}

.onboard-body {
  padding-bottom: 12rpx;
}

.onboard-form-card {
  padding: 28rpx 28rpx 10rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(233, 239, 236, 0.96);
  box-shadow: 0 18rpx 40rpx rgba(29, 39, 45, 0.08);
}

.onboard-section {
  margin-bottom: 28rpx;
}

.onboard-section--phone {
  margin-bottom: 28rpx;
}

.onboard-section--last {
  margin-bottom: 0;
}

.onboard-section-label {
  margin-bottom: 14rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #16211b;
}

.onboard-hint {
  margin-bottom: 14rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #8a8f99;
}

.onboard-tip {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.45;
  color: #8a8f99;
}

.stage-row {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: rgba(17, 19, 24, 0.05);
}

.stage-chip {
  flex: 1;
  height: 64rpx;
  border-radius: 18rpx;
  background: transparent;
  border: none;
  color: #667085;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-shadow: none;
}

.stage-chip.sel {
  background: #ffffff;
  border: none;
  color: #16211b;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(17, 19, 24, 0.08);
}

.grade-picker-panel {
  padding: 20rpx 18rpx 8rpx;
  border-radius: 24rpx;
  background: rgba(120, 172, 244, 0.08);
  border: 1rpx solid rgba(120, 172, 244, 0.16);
}

.grade-picker-hint {
  margin-bottom: 14rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #5a7394;
}

.grade-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.grade-chip,
.version-chip,
.semester-chip,
.gender-chip {
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #fbfcfc;
  border: 1rpx solid #e7ece9;
  color: #1c2721;
  font-size: 28rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-shadow: inset 0 -4rpx 12rpx rgba(255, 255, 255, 0.4);
}

.grade-chip {
  width: calc((100% - 32rpx) / 3);
  height: 88rpx;
}

.semester-inline {
  display: flex;
  gap: 16rpx;
}

.semester-chip {
  flex: 1;
  min-height: 88rpx;
  padding: 14rpx 16rpx;
  flex-direction: column;
  gap: 4rpx;
}

.semester-chip-name {
  font-size: 28rpx;
  font-weight: 400;
  color: inherit;
  line-height: 1.2;
}

.semester-chip-tag {
  font-size: 22rpx;
  font-weight: 400;
  color: #8a8f99;
  line-height: 1.2;
}

.version-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.version-chip {
  width: calc((100% - 16rpx) / 2);
  min-height: 88rpx;
  padding: 0 20rpx;
  line-height: 1.3;
}

.version-more-toggle {
  margin-top: 4rpx;
  padding: 18rpx 0 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.version-more-text {
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1;
  color: #17b65a;
  display: block;
}

.version-more-icon {
  width: 10rpx;
  height: 10rpx;
  border-right: 2rpx solid #17b65a;
  border-bottom: 2rpx solid #17b65a;
  box-sizing: border-box;
  transform: rotate(45deg);
  transition: transform 0.2s ease;
  flex-shrink: 0;
  margin-top: -5rpx;
}

.version-more-toggle-expanded .version-more-icon {
  transform: rotate(-135deg);
  margin-top: 5rpx;
}

.gender-row {
  display: flex;
  gap: 16rpx;
}

.gender-chip {
  flex: 1;
  height: 88rpx;
}

.grade-chip.sel,
.version-chip.sel,
.semester-chip.sel,
.gender-chip.sel {
  background: linear-gradient(135deg, #1ed067 0%, #17b65a 100%);
  border-color: #17b65a;
  color: #fff;
  font-weight: 500;
  box-shadow: 0 12rpx 24rpx rgba(23, 182, 90, 0.2);
}

.semester-chip.sel .semester-chip-name,
.semester-chip.sel .semester-chip-tag {
  color: #fff;
}

.semester-chip.sel .semester-chip-tag {
  color: rgba(255, 255, 255, 0.72);
}

.phone-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background: #fbfcfc;
  border: 1rpx solid #e7ece9;
  box-shadow: inset 0 -4rpx 12rpx rgba(255, 255, 255, 0.4);
}

.phone-row-copy {
  flex: 1;
  min-width: 0;
}

.phone-row-text {
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.45;
  color: #1c2721;
}

.phone-row-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx !important;
  border: none !important;
  background: linear-gradient(135deg, #1ed067 0%, #17b65a 100%) !important;
  color: #ffffff !important;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 18rpx rgba(23, 182, 90, 0.18);
}

.phone-row-done {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f7a4d;
}

/* 邀请码（选填）：扫码/分享自动填入可修改，完成引导后绑定锁定 */
.invite-code-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background: #fbfcfc;
  border: 1rpx solid #e7ece9;
  box-shadow: inset 0 -4rpx 12rpx rgba(255, 255, 255, 0.4);
}

.invite-code-row--valid {
  border-color: rgba(30, 208, 103, 0.55);
  background: rgba(30, 208, 103, 0.05);
}

.invite-code-row--invalid {
  border-color: rgba(224, 82, 82, 0.55);
  background: rgba(224, 82, 82, 0.04);
}

.invite-code-input {
  flex: 1;
  min-width: 0;
  height: 48rpx;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  font-family: Menlo, Consolas, monospace;
  color: #16211b;
}

.invite-code-clear {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #c9d2e0;
  color: #ffffff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.invite-inviter-preview {
  margin-top: 10rpx;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(30, 208, 103, 0.1);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.45;
  color: #1f7a4d;
}

.invite-error {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #d05252;
}

.invite-lock-tip {
  margin-top: 10rpx;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(240, 138, 47, 0.1);
  font-size: 22rpx;
  line-height: 1.5;
  color: #b98134;
}

.onboard-footer {
  flex-shrink: 0;
  padding: 16rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(120, 172, 244, 0) 0%, rgba(120, 172, 244, 0.42) 100%);
}

.onboard-next {
  width: 100%;
  height: 96rpx;
  font-size: 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #171b20 0%, #0f1114 100%);
  box-shadow: 0 16rpx 28rpx rgba(17, 19, 24, 0.18);
  transition: opacity 0.2s ease, box-shadow 0.2s ease;
}

.onboard-next--disabled {
  background: linear-gradient(135deg, #4a5560 0%, #3a424b 100%);
  box-shadow: 0 10rpx 20rpx rgba(17, 19, 24, 0.1);
}

.onboard-skip-link {
  margin-top: 18rpx;
  padding: 12rpx 0;
  text-align: center;
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 600;
