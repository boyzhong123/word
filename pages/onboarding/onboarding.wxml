<!--pages/onboarding/onboarding.wxml-->
<view class="page onboard">
  <view class="onboard-nav" style="height: {{navBarHeightRpx}}rpx;">
    <view
      class="onboard-nav-title-wrap"
      style="top: {{navBackTopRpx}}rpx; height: {{navBackSizeRpx}}rpx;"
    >
      <view class="onboard-nav-title">{{appName}}</view>
    </view>
    <view
      wx:if="{{showBackButton}}"
      class="onboard-back-btn"
      style="top: {{navBackTopRpx}}rpx; width: {{navBackSizeRpx}}rpx; height: {{navBackSizeRpx}}rpx;"
      hover-class="onboard-back-btn-hover"
      bindtap="prevOnboardingStep"
    >
      <view class="onboard-back-icon"></view>
    </view>
  </view>

  <scroll-view class="onboard-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="onboard-panel">
      <!-- step 0: 欢迎（三张长图 + 底部按钮） -->
      <block wx:if="{{onboardingStep === 0}}">
        <view class="onboard-head onboard-head--intro">
          <view class="onboard-kicker">{{stepKicker}}</view>
          <view class="onboard-title">{{stepCopy.title}}</view>
          <view class="onboard-sub">{{stepCopy.sub}}</view>
        </view>
        <view class="onboard-panel-stack">
          <image
            wx:for="{{introPanels}}"
            wx:key="*this"
            class="onboard-panel-img"
            src="{{item}}"
            mode="widthFix"
          />
        </view>
      </block>

      <!-- step 1-3 -->
      <block wx:else>
        <view class="onboard-step-banner onboard-step-banner--form">
          <image class="onboard-step-banner-img" src="{{onboardHeroSrc}}" mode="aspectFill" />
          <view class="onboard-step-banner-fade"></view>
        </view>

        <view class="onboard-head">
          <view class="onboard-kicker">{{stepKicker}}</view>
          <view class="onboard-title">{{stepCopy.title}}</view>
          <view class="onboard-sub">{{stepCopy.sub}}</view>
        </view>

        <view class="onboard-steps">
          <view class="onboard-dot {{onboardingStep >= 1 ? 'on' : ''}}">1</view>
          <view class="onboard-line {{onboardingStep >= 2 ? 'on' : ''}}"></view>
          <view class="onboard-dot {{onboardingStep >= 2 ? 'on' : ''}}">2</view>
          <view class="onboard-line {{onboardingStep >= 3 ? 'on' : ''}}"></view>
          <view class="onboard-dot {{onboardingStep >= 3 ? 'on' : ''}}">3</view>
        </view>

        <!-- step 1: 年级 + 学期 -->
        <view wx:if="{{onboardingStep === 1}}" class="onboard-body onboard-form-card">
          <view class="onboard-section">
            <view class="onboard-section-label">就读年级</view>
            <view class="stage-row">
              <view
                wx:for="{{gradeGroups}}"
                wx:key="stage"
                class="stage-chip {{selectedStage === item.stage ? 'sel' : ''}}"
                data-stage="{{item.stage}}"
                bindtap="selectStage"
              >{{item.stageName}}</view>
            </view>
            <view class="grade-picker-panel">
              <view class="grade-picker-hint">选择年级</view>
              <view class="grade-grid">
                <view
                  wx:for="{{visibleGrades}}"
                  wx:key="id"
                  class="grade-chip {{selectedGradeId === item.id ? 'sel' : ''}}"
                  data-id="{{item.id}}"
                  bindtap="selectGrade"
                >{{item.name}}</view>
              </view>
            </view>
          </view>

          <view class="onboard-section">
            <view class="onboard-section-label">当前学期</view>
            <view class="semester-inline">
              <view
                wx:for="{{semesters}}"
                wx:key="id"
                class="semester-chip {{selectedSemesterId === item.id ? 'sel' : ''}}"
                data-id="{{item.id}}"
                bindtap="selectSemester"
              >
                <view class="semester-chip-name">{{item.name}}</view>
                <view class="semester-chip-tag">{{item.id === 'first' ? '上册' : '下册'}}</view>
              </view>
            </view>
          </view>
        </view>

        <!-- step 2: 教材 -->
        <view wx:if="{{onboardingStep === 2}}" class="onboard-body onboard-form-card">
          <view class="onboard-section onboard-section--last">
            <view class="onboard-section-label">教材版本</view>
            <view class="onboard-hint" wx:if="{{!selectedGradeId}}">请先在上一步选择年级</view>
            <view class="version-grid">
              <view
                wx:for="{{displayVersions}}"
                wx:key="*this"
                class="version-chip {{selectedVersion === item ? 'sel' : ''}}"
                data-version="{{item}}"
                bindtap="selectVersion"
              >{{item}}</view>
            </view>
            <view
              wx:if="{{showVersionMoreToggle}}"
              class="version-more-toggle {{versionsExpanded ? 'version-more-toggle-expanded' : ''}}"
              bindtap="toggleVersionMore"
            >
              <text class="version-more-text">{{versionMoreLabel}}</text>
              <view class="version-more-icon" aria-hidden="true"></view>
            </view>
          </view>
        </view>

        <!-- step 3: 选填 -->
        <view wx:if="{{onboardingStep === 3 && !editMode}}" class="onboard-body onboard-form-card">
          <view class="onboard-section">
            <view class="onboard-section-label">学习形象（选填）</view>
            <view class="gender-row">
              <view
                class="gender-chip {{selectedChildGender === 'boy' ? 'sel' : ''}}"
                data-gender="boy"
                bindtap="selectChildGender"
              >男孩</view>
              <view
                class="gender-chip {{selectedChildGender === 'girl' ? 'sel' : ''}}"
                data-gender="girl"
                bindtap="selectChildGender"
              >女孩</view>
            </view>
            <view class="onboard-tip">用于首页和学习场景中的角色形象</view>
          </view>

          <view class="onboard-section onboard-section--phone">
            <view class="onboard-section-label">手机号（选填）</view>
            <view class="phone-row">
              <view class="phone-row-copy">
                <text class="phone-row-text">{{phoneVerified ? ('已授权 ' + maskedPhone) : '用于推荐学习资料'}}</text>
              </view>
              <button
                wx:if="{{!phoneVerified}}"
                class="phone-row-btn"
                plain
                hover-class="none"
                open-type="getPhoneNumber"
                bindgetphonenumber="handleGetPhoneNumber"
              >授权</button>
              <text wx:else class="phone-row-done">已完成</text>
            </view>
          </view>

          <view class="onboard-section onboard-section--last">
            <view class="onboard-section-label">邀请码（选填）</view>
            <view class="invite-code-row invite-code-row--{{inviteState}}">
              <input
                class="invite-code-input"
                value="{{inviteCode}}"
                maxlength="10"
                placeholder="朋友的邀请码，没有可不填"
                placeholder-style="color: #b6bfce; font-weight: 400; letter-spacing: 0;"
                confirm-type="done"
                bindinput="handleInviteCodeInput"
                bindblur="handleInviteCodeBlur"
                bindconfirm="handleInviteCodeBlur"
              />
              <view wx:if="{{inviteCode}}" class="invite-code-clear" catchtap="clearInviteCode">✕</view>
            </view>
            <view wx:if="{{inviteState === 'valid'}}" class="invite-inviter-preview">
              邀请人：{{inviteInviterName}}{{inviteSource === 'manual' ? '' : ' · 自动填入，可修改'}}
            </view>
            <view wx:elif="{{inviteState === 'invalid'}}" class="invite-error">{{inviteError}}</view>
            <view wx:elif="{{inviteState === 'checking'}}" class="onboard-tip">邀请码校验中…</view>
            <view wx:else class="onboard-tip">在好友的「我的 → 邀请好友」里可以找到邀请码</view>
            <view wx:if="{{inviteCode}}" class="invite-lock-tip">完成新手引导后，邀请关系将绑定且不可再修改</view>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>

  <view class="onboard-footer">
    <view
      class="app-btn app-btn-primary onboard-next {{primaryButtonDisabled ? 'onboard-next--disabled' : ''}}"
      bindtap="nextOnboardingStep"
    >
      {{primaryButtonText}}
    </view>
    <view
      wx:if="{{onboardingStep === 3 && !editMode}}"
      class="onboard-skip-link"
      hover-class="onboard-skip-link-hover"
      bindtap="skipOptionalStep"
    >跳过，先开始学习</view>
  </view>
</view>
