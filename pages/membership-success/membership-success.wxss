page {
  height: 100%;
  overflow: hidden;
  background: #e7e1f0;
  color: #263f45;
}

.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background:
    linear-gradient(150deg, rgba(251, 86, 50, 0.08), rgba(251, 86, 50, 0) 27%),
    linear-gradient(215deg, rgba(80, 125, 235, 0.18), rgba(80, 125, 235, 0) 42%),
    linear-gradient(180deg, #e7e1f0 0%, #d9dcf4 35%, #9bbef4 100%);
  font-family: PingFang SC, PingFangSC-Regular, sans-serif;
}

.success-nav {
  flex: none;
  position: relative;
  z-index: 10;
}

.nav-title-wrap {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.nav-title-text {
  color: #263f45;
  font-size: 32rpx;
  font-weight: 700;
}

.success-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
}

.success-content {
  padding: 12rpx 30rpx 190rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.success-image {
  width: 100%;
  height: 450rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 14rpx 34rpx rgba(73, 105, 172, 0.13);
}

.success-title {
  margin-top: 28rpx;
  color: #111318;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 58rpx;
}

.success-sub {
  margin-top: 8rpx;
  color: rgba(38, 63, 69, 0.62);
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

.unlock-grid {
  width: 100%;
  margin-top: 26rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.unlock-item {
  height: 104rpx;
  padding: 10rpx 14rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.56);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  color: #263f45;
  font-size: 22rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.unlock-image {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: 16rpx;
}

.success-order {
  width: 100%;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  box-shadow: 0 10rpx 24rpx rgba(73, 105, 172, 0.09);
  box-sizing: border-box;
}

.success-order-head {
  padding-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(91, 126, 195, 0.1);
  color: #151923;
  font-size: 28rpx;
  font-weight: 750;
}

.success-order-price {
  color: #fb5632;
  font-size: 34rpx;
}

.success-order-row {
  min-height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: rgba(47, 67, 78, 0.56);
  font-size: 22rpx;
}

.success-order-row text:last-child {
  color: #263f45;
  text-align: right;
}

.records-link {
  margin-top: 24rpx;
  color: #315fba;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 34rpx;
}

.success-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 18rpx 30rpx 24rpx;
  background: rgba(235, 241, 254, 0.95);
  border-top: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 -14rpx 30rpx rgba(56, 87, 150, 0.12);
  box-sizing: border-box;
}

.success-button {
  height: 92rpx;
  border-radius: 999rpx;
  background: #111318;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 750;
  line-height: 92rpx;
  text-align: center;
  box-shadow: 0 12rpx 26rpx rgba(17, 19, 24, 0.18);
}
