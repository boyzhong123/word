page {
  height: 100%;
  background: #eef3f9;
  color: #14233a;
}

.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #eef3f9;
  font-family: PingFang SC, PingFangSC-Regular, sans-serif;
}

.title-box {
  position: relative;
  flex: none;
  background: #fbfcff;
  border-bottom: 1rpx solid rgba(18, 47, 75, 0.06);
}

.ad-nav-title-wrap {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 120rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.ad-nav-title {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #183655;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
}

.content {
  flex: none;
  width: 100%;
}

/* ---------- 商品详情长图 ---------- */
.detail-long {
  width: 100%;
  font-size: 0;
  background: #fffdf8;
}

.detail-long-image {
  display: block;
  width: 100%;
  vertical-align: top;
}

/* ---------- 详情 / 评价 切换 ---------- */
.detail-tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  margin-top: 20rpx;
  background: #ffffff;
  border-top: 1rpx solid rgba(17, 19, 24, 0.06);
  border-bottom: 1rpx solid rgba(17, 19, 24, 0.06);
}

.detail-tab {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 22rpx 0 18rpx;
}

.detail-tab-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #7a8798;
}

.detail-tab-bar {
  width: 44rpx;
  height: 6rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  background: transparent;
}

.detail-tab-on .detail-tab-text {
  color: #17406f;
  font-weight: 700;
}

.detail-tab-on .detail-tab-bar {
  background: #ff8200;
}

/* ---------- 宝贝评价（淘宝风） ---------- */
.reviews {
  padding: 28rpx 28rpx 8rpx;
  background: #ffffff;
}

.reviews-head {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  margin-bottom: 18rpx;
}

.reviews-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #17406f;
}

.reviews-recent {
  margin-left: 14rpx;
  font-size: 23rpx;
  color: #9aa3b2;
}

.review-tags {
  white-space: nowrap;
  margin-bottom: 6rpx;
}

.review-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-right: 16rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #fff6ec;
}

.review-tag-on {
  background: #ff8200;
}

.review-tag-label {
  font-size: 24rpx;
  color: #c2691a;
}

.review-tag-count {
  font-size: 22rpx;
  color: #e0a878;
}

.review-tag-on .review-tag-label,
.review-tag-on .review-tag-count {
  color: #ffffff;
}

.review-item {
  padding: 28rpx 0;
  border-top: 1rpx solid rgba(17, 19, 24, 0.07);
}

.review-top {
  display: flex;
  align-items: flex-start;
}

.review-avatar {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.review-id {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}

.review-name {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  color: #333a45;
  line-height: 36rpx;
}

.review-sub {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 4rpx;
}

.review-date {
  font-size: 22rpx;
  color: #b6bdc8;
}

.review-spec {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: #aab2bd;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-stars {
  flex: none;
  display: flex;
  margin-left: 12rpx;
  padding-top: 4rpx;
}

.review-star {
  font-size: 22rpx;
  color: #dfe3ea;
  letter-spacing: 1rpx;
}

.review-star-on {
  color: #ffb400;
}

.review-text {
  display: block;
  margin-top: 16rpx;
  font-size: 27rpx;
  line-height: 40rpx;
  color: #2b323c;
}

.review-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.review-img {
  width: 210rpx;
  height: 210rpx;
  border-radius: 12rpx;
  background: #f2f4f7;
}

.review-more {
  margin: 24rpx auto 12rpx;
  width: 360rpx;
  padding: 20rpx 0;
  border: 1rpx solid rgba(24, 35, 49, 0.16);
  border-radius: 999rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #3a4351;
}

/* ---------- Hero ---------- */
.hero {
  position: relative;
  height: 340rpx;
  overflow: hidden;
  background: linear-gradient(160deg, #ffe3b0 0%, #fff1d6 46%, #fffaf0 100%);
}

.hero-image {
  display: block;
  width: 100%;
  height: 100%;
  object-position: 72% center;
}

.hero-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 80rpx;
  background: linear-gradient(180deg, rgba(238, 243, 249, 0) 0%, rgba(238, 243, 249, 0.65) 100%);
}

/* ---------- Book card ---------- */
.book-card {
  position: relative;
  margin: -104rpx 29rpx 0;
  padding: 0 30rpx;
  border-radius: 29rpx;
  background: #ffffff;
  border: 1rpx solid rgba(24, 35, 49, 0.08);
  box-shadow: 0 14rpx 34rpx rgba(169, 118, 14, 0.12);
}

.book-main {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.book-cover-frame {
  flex: none;
  width: 168rpx;
  height: 238rpx;
  margin-top: -66rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 36rpx rgba(169, 118, 14, 0.22), 0 4rpx 10rpx rgba(24, 35, 49, 0.08);
  box-sizing: border-box;
}

.book-cover {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.book-meta {
  flex: 1;
  min-width: 0;
}

.book-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.grade-pill {
  max-width: 100%;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  color: #1f6b5f;
  background: #e4f5ef;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 42rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.press-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  max-width: 100%;
  margin-top: 18rpx;
  padding: 8rpx 18rpx 8rpx 12rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  background: rgba(255, 130, 0, 0.1);
  border: 1rpx solid rgba(255, 130, 0, 0.22);
}

.press-pill-icon {
  flex: none;
  width: 32rpx;
  height: 32rpx;
}

.press-pill-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #b06200;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.book-name {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: #17406f;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 50rpx;
  letter-spacing: -0.5rpx;
}

/* ---------- Stat strip ---------- */
.stat-row {
  display: flex;
  margin-top: 24rpx;
  padding: 26rpx 8rpx;
  border-top: 1rpx solid rgba(24, 35, 49, 0.07);
}

.stat-item {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 0 6rpx;
}

.stat-item + .stat-item::before {
  content: '';
  position: absolute;
  top: 14rpx;
  bottom: 14rpx;
  left: 0;
  width: 1rpx;
  background: rgba(24, 35, 49, 0.08);
}

.stat-num-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.stat-value {
  color: #17406f;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 46rpx;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.5rpx;
}

.stat-unit {
  margin-left: 4rpx;
  color: #9aa3b2;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 30rpx;
}

.stat-label {
  color: #7a8798;
  font-size: 22rpx;
  line-height: 30rpx;
}

/* ---------- Sections ---------- */
.section {
  margin: 36rpx 28rpx 0;
}

.section-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.section-head::before {
  content: '';
  flex: none;
  width: 8rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #2f78b8 0%, #123b63 100%);
}

.section-title {
  flex: none;
  color: #102a47;
  font-size: 33rpx;
  font-weight: 800;
  line-height: 44rpx;
  letter-spacing: 0.3rpx;
}

.section-note {
  flex: 1;
  color: #93a0b1;
  font-size: 21rpx;
  line-height: 30rpx;
  text-align: right;
}

/* unified list cards */
.scope-list,
.feature-list,
.timeline {
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border-radius: 22rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 30rpx rgba(33, 66, 104, 0.06);
}

.scope-row,
.feature-item,
.timeline-item {
  background: transparent;
  border: none;
  border-radius: 0;
}

.scope-row + .scope-row,
.feature-item + .feature-item,
.timeline-item + .timeline-item {
  border-top: 1rpx solid rgba(18, 47, 75, 0.07);
}

.scope-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 26rpx;
}

.scope-label {
  flex: none;
  color: #7e8b9c;
  font-size: 24rpx;
  line-height: 34rpx;
}

.scope-value {
  flex: 1;
  color: #21364c;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 34rpx;
  text-align: right;
}

.scope-tags {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
}

.scope-tag {
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #1f6b5f;
  background: #e4f5ef;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 38rpx;
}

/* feature rows */
.feature-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 26rpx;
}

.feature-mark {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #dceeff;
  color: #1d5f95;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 56rpx;
  text-align: center;
}

.feature-item:nth-child(2) .feature-mark {
  background: #e3f6e6;
  color: #2f7a39;
}

.feature-item:nth-child(3) .feature-mark {
  background: #fff0d5;
  color: #9d6414;
}

.feature-item:nth-child(4) .feature-mark {
  background: #ffe7e2;
  color: #a84b3b;
}

.feature-copy {
  flex: 1;
  min-width: 0;
}

.feature-title,
.timeline-title {
  display: block;
  color: #1c324c;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.feature-desc,
.timeline-desc {
  display: block;
  margin-top: 5rpx;
  color: #6b7a8c;
  font-size: 23rpx;
  line-height: 34rpx;
}

/* timeline (numbered steps) */
.timeline-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 26rpx;
}

.timeline-index {
  position: relative;
  flex: none;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2f78b8 0%, #123b63 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 50rpx;
  text-align: center;
  box-shadow: 0 8rpx 16rpx rgba(18, 59, 99, 0.22);
}

.timeline-item:not(:last-child) .timeline-index::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 58rpx;
  width: 2rpx;
  height: 44rpx;
  transform: translateX(-50%);
  background: rgba(20, 51, 88, 0.14);
}

.timeline-copy {
  flex: 1;
  min-width: 0;
}

/* ---------- Spec comparison table ---------- */
.compare-table {
  display: flex;
  flex-direction: column;
  border-radius: 22rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(33, 66, 104, 0.06);
}

.compare-head {
  display: flex;
  align-items: stretch;
  background: #f6f9fc;
}

.compare-row {
  display: flex;
  align-items: stretch;
  border-top: 1rpx solid rgba(18, 47, 75, 0.07);
}

.compare-cell {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 8rpx;
}

.compare-cell-label {
  flex: 2.3;
  justify-content: flex-start;
  padding-left: 26rpx;
  color: #4f5f76;
  font-size: 23rpx;
  line-height: 32rpx;
  text-align: left;
}

.compare-cell-plan {
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
  padding-top: 26rpx;
  padding-bottom: 26rpx;
}

.compare-cell-val {
  flex: 1;
}

.compare-col-hl {
  background: #eef9f2;
}

.compare-plan-top {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.compare-plan-name {
  color: #1c324c;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 32rpx;
  text-align: center;
}

.compare-plan-tag {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #ff6a3d;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 26rpx;
}

.compare-plan-price {
  display: flex;
  align-items: baseline;
  margin-top: 2rpx;
}

.compare-plan-currency {
  color: #ff6a3d;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 28rpx;
}

.compare-plan-amount {
  margin-left: 1rpx;
  color: #ff6a3d;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 38rpx;
  font-variant-numeric: tabular-nums;
}

.compare-plan-from {
  margin-left: 3rpx;
  color: #b07b2a;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 26rpx;
}

.compare-yes {
  color: #34b277;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 32rpx;
}

.compare-no {
  color: #c2ccd8;
  font-size: 26rpx;
  line-height: 32rpx;
}

.compare-foot {
  display: block;
  margin-top: 18rpx;
  padding: 0 6rpx;
  color: #93a0b1;
  font-size: 21rpx;
  line-height: 32rpx;
}

.intro-text {
  display: block;
  padding: 26rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(33, 66, 104, 0.06);
  color: #54637a;
  font-size: 26rpx;
  line-height: 44rpx;
}

/* ---------- Purchase bar ---------- */
.purchase-bar {
  flex: none;
  z-index: 10;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 28rpx;
  border-top: 1rpx solid rgba(18, 47, 75, 0.08);
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -12rpx 34rpx rgba(28, 62, 99, 0.1);
}

.purchase-price {
  flex: none;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.purchase-price-row {
  display: flex;
  align-items: baseline;
}

.purchase-currency {
  color: #ff6a3d;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.purchase-amount {
  margin-left: 2rpx;
  color: #ff6a3d;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 54rpx;
  font-variant-numeric: tabular-nums;
}

.purchase-from {
  margin-left: 6rpx;
  color: #b07b2a;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 30rpx;
}

.purchase-price-note {
  margin-top: 2rpx;
  color: #93a0b1;
  font-size: 20rpx;
  line-height: 28rpx;
}

.purchase-button {
  height: 92rpx;
  border-radius: 999rpx;
  background: #111318;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 92rpx;
  text-align: center;
  letter-spacing: 2rpx;
}

.purchase-button-buy {
  flex: 1;
  background: linear-gradient(135deg, #ffa11c 0%, #ff7a18 100%);
  box-shadow: 0 14rpx 26rpx rgba(255, 130, 0, 0.32);
}

.purchase-button-owned {
  flex: 1;
  background: rgba(52, 178, 119, 0.14);
  color: #1f8a57;
  box-shadow: none;
}

.purchase-button-buy:active {
  transform: translateY(1rpx);
  opacity: 0.92;
}

.purchase-button-owned:active {
  opacity: 1;
}

/* ---------- SKU sheet ---------- */
.sku-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(16, 24, 40, 0.52);
}

.sku-sheet {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 86vh;
  overflow: hidden;
  border-radius: 34rpx 34rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -16rpx 48rpx rgba(23, 64, 111, 0.14);
  animation: sku-slide-up 0.26s cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes sku-slide-up {
  0% {
    transform: translateY(100%);
    opacity: 0.92;
  }
  100% {
    transform: translateY(0);
    opacity: 1;
  }
}

.sku-handle {
  flex: none;
  width: 72rpx;
  height: 8rpx;
  margin: 16rpx auto 0;
  border-radius: 999rpx;
  background: rgba(18, 47, 75, 0.12);
}

.sku-book {
  position: relative;
  flex: none;
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  padding: 24rpx 32rpx 22rpx;
  border-bottom: 1rpx solid rgba(18, 47, 75, 0.08);
}

.sku-close {
  position: absolute;
  top: 18rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(18, 47, 75, 0.06);
  color: #7e8b9c;
  font-size: 26rpx;
  line-height: 48rpx;
  text-align: center;
}

.sku-close:active {
  background: rgba(18, 47, 75, 0.12);
}

.sku-body {
  flex: 1;
  min-height: 0;
  padding-bottom: 8rpx;
}

.sku-cover {
  width: 96rpx;
  height: 128rpx;
  border-radius: 12rpx;
  flex: none;
  box-shadow: 0 8rpx 18rpx rgba(18, 47, 75, 0.14);
}

.sku-book-meta {
  flex: 1;
  min-width: 0;
  padding-right: 52rpx;
}

.sku-book-name {
  display: block;
  color: #102a47;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.sku-book-stats {
  display: block;
  margin-top: 10rpx;
  color: #6b7a8c;
  font-size: 22rpx;
  line-height: 32rpx;
}

.sku-book-press {
  display: block;
  margin-top: 8rpx;
  color: #93a0b1;
  font-size: 20rpx;
  line-height: 30rpx;
}

.sku-title {
  padding: 26rpx 32rpx 16rpx;
  color: #102a47;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.sku-options {
  display: flex;
  gap: 18rpx;
  padding: 0 32rpx;
}

.sku-option {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 116rpx;
  padding: 22rpx 20rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(18, 47, 75, 0.1);
  background: #ffffff;
  overflow: hidden;
  transition: all 0.18s ease;
}

.sku-option-active {
  border-color: #34b277;
  background: #effaf3;
  box-shadow: 0 10rpx 28rpx rgba(52, 178, 119, 0.16);
}

.sku-option:active {
  transform: scale(0.98);
}

.sku-tick {
  position: absolute;
  top: 0;
  right: 0;
  width: 42rpx;
  height: 42rpx;
  border-radius: 0 18rpx 0 18rpx;
  background: #34b277;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 42rpx;
  text-align: center;
}

.sku-option-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  padding-right: 36rpx;
}

.sku-option-name {
  color: #1f344d;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.sku-option-active .sku-option-name {
  color: #1f7a4d;
}

.sku-pill {
  flex: none;
  padding: 1rpx 12rpx;
  border-radius: 999rpx;
  background: #ff6a3d;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 28rpx;
}

.sku-option-desc {
  display: block;
  margin-top: 8rpx;
  color: #6b7a8c;
  font-size: 21rpx;
  line-height: 30rpx;
}

.sku-includes {
  margin: 28rpx 32rpx 8rpx;
  padding: 24rpx 26rpx;
  border-radius: 20rpx;
  background: #f4f7fb;
}

.sku-includes-title {
  margin-bottom: 14rpx;
  color: #102a47;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.sku-includes-item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 10rpx;
}

.sku-check {
  flex: none;
  width: 28rpx;
  color: #34b277;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 32rpx;
  text-align: center;
}

.sku-includes-text {
  flex: 1;
  color: #54637a;
  font-size: 22rpx;
  line-height: 32rpx;
}

.sku-actions {
  flex: none;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 18rpx 32rpx 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(18, 47, 75, 0.08);
  box-shadow: 0 -10rpx 26rpx rgba(28, 62, 99, 0.06);
}

.sku-foot-price {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.sku-foot-label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #7e8b9c;
  font-size: 20rpx;
  line-height: 28rpx;
}

.sku-foot-amount-row {
  display: flex;
  align-items: baseline;
  margin-top: 2rpx;
}

.sku-foot-currency {
  color: #ff6a3d;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 36rpx;
}

.sku-foot-amount {
  margin-left: 2rpx;
  color: #ff6a3d;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 54rpx;
  font-variant-numeric: tabular-nums;
}

.sku-confirm {
  flex: none;
  min-width: 300rpx;
  padding: 0 56rpx;
  height: 92rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffa11c 0%, #ff7a18 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 92rpx;
  text-align: center;
  letter-spacing: 1rpx;
  box-shadow: 0 14rpx 26rpx rgba(255, 130, 0, 0.32);
}

.sku-confirm:active {
  transform: translateY(1rpx);
  opacity: 0.92;
}
