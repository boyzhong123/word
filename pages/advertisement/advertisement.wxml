<view class="page">
  <navigation class="title-box" background="#fbfcff">
    <view class="ad-nav-title-wrap">
      <view class="ad-nav-title">{{name || '教材详情'}}</view>
    </view>
  </navigation>

  <scroll-view scroll-y class="content" style="height: {{scrollHeight}}px;" enhanced show-scrollbar="{{false}}">
    <view class="hero">
      <image class="hero-image" src="{{imageBaseUrl}}/images/home/ad/product-hero-purchase-v3.jpg" mode="aspectFill" />
      <view class="hero-fade"></view>
    </view>

    <view class="book-card">
      <view class="book-main">
        <view class="book-cover-frame">
          <image class="book-cover" src="{{bookCover}}" mode="aspectFill" binderror="onBookCoverError" />
        </view>
        <view class="book-meta">
          <text class="book-name">{{name}}</text>
          <view wx:if="{{press}}" class="press-pill">
            <image class="press-pill-icon" src="{{imageBaseUrl}}/images/home/ad/icon-press-jelly.png" mode="aspectFit" />
            <text class="press-pill-text">{{press}}</text>
          </view>
          <view wx:else class="book-pills">
            <view wx:for="{{gradeTags}}" wx:key="*this" class="grade-pill">{{item}}</view>
          </view>
        </view>
      </view>

      <view class="stat-row">
        <view class="stat-item" wx:for="{{contentStats}}" wx:key="label">
          <image class="stat-icon" src="{{imageBaseUrl}}/images/home/ad/icon-{{item.iconKey}}-jelly.png" mode="aspectFit" />
          <view class="stat-num-row">
            <text class="stat-value">{{item.value}}</text>
            <text class="stat-unit">{{item.unit}}</text>
          </view>
          <text class="stat-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="section section-scope">
      <view class="section-head">
        <text class="section-title">这本书适合谁</text>
        <text class="section-note">初中同步 · 自主备考都适用</text>
      </view>
      <view class="scope-list">
        <view class="scope-row">
          <text class="scope-label">适用年级</text>
          <view class="scope-tags">
            <text wx:for="{{gradeTags}}" wx:key="*this" class="scope-tag">{{item}}</text>
          </view>
        </view>
        <view wx:if="{{press}}" class="scope-row">
          <text class="scope-label">出版社</text>
          <text class="scope-value">{{press}}</text>
        </view>
        <view class="scope-row">
          <text class="scope-label">内容范围</text>
          <text class="scope-value">{{wordCountText}} 个单词 / {{proverbCountText}} 条句子 / {{totalText}} 个单元</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">购买后包含</text>
        <text class="section-note">词典查阅 + 智能学习任务</text>
      </view>
      <view class="feature-list">
        <view class="feature-item" wx:for="{{featureCards}}" wx:key="title">
          <view class="feature-mark">{{item.mark}}</view>
          <view class="feature-copy">
            <text class="feature-title">{{item.title}}</text>
            <text class="feature-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">学习方式</text>
        <text class="section-note">按单元推进，循序渐进</text>
      </view>
      <view class="timeline">
        <view class="timeline-item" wx:for="{{methodSteps}}" wx:key="title">
          <view class="timeline-index">{{index + 1}}</view>
          <view class="timeline-copy">
            <text class="timeline-title">{{item.title}}</text>
            <text class="timeline-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">规格对比</text>
        <text class="section-note">两种套餐，看清区别再选</text>
      </view>

      <view class="compare-table">
        <view class="compare-head">
          <view class="compare-cell compare-cell-label"></view>
          <view
            wx:for="{{comparePlans}}"
            wx:key="name"
            class="compare-cell compare-cell-plan {{item.highlight ? 'compare-col-hl' : ''}}"
          >
            <view class="compare-plan-top">
              <text class="compare-plan-name">{{item.name}}</text>
              <text wx:if="{{item.tag}}" class="compare-plan-tag">{{item.tag}}</text>
            </view>
            <view class="compare-plan-price">
              <text class="compare-plan-currency">¥</text>
              <text class="compare-plan-amount">{{item.priceFrom}}</text>
              <text class="compare-plan-from">起</text>
            </view>
          </view>
        </view>

        <view class="compare-row" wx:for="{{compareRows}}" wx:key="label" wx:for-item="row">
          <text class="compare-cell compare-cell-label">{{row.label}}</text>
          <view
            wx:for="{{row.cells}}"
            wx:key="*this"
            wx:for-item="cell"
            class="compare-cell compare-cell-val {{index === 1 ? 'compare-col-hl' : ''}}"
          >
            <text wx:if="{{cell}}" class="compare-yes">✓</text>
            <text wx:else class="compare-no">—</text>
          </view>
        </view>
      </view>

      <text class="compare-foot">有效期可选 6 个月或永久有效，永久一次购买长期使用 · 点击「立即购买」选择具体规格</text>
    </view>

    <view wx:if="{{intro}}" class="section">
      <view class="section-head">
        <text class="section-title">教材简介</text>
      </view>
      <text class="intro-text">{{intro}}</text>
    </view>

    <view style="height: {{actionHeight}}px;"></view>
  </scroll-view>

  <view class="purchase-bar" style="padding-bottom: {{safeAreaBottom}}px;">
    <view wx:if="{{unlocked}}" class="purchase-button purchase-button-owned">已购买</view>
    <block wx:else>
      <view class="purchase-price">
        <view class="purchase-price-row">
          <text class="purchase-currency">¥</text>
          <text class="purchase-amount">{{minPrice}}</text>
          <text class="purchase-from">起</text>
        </view>
        <text class="purchase-price-note">{{skuCount}} 种规格可选</text>
      </view>
      <view class="purchase-button purchase-button-buy" bindtap="openSkuSheet">立即购买</view>
    </block>
  </view>

  <view wx:if="{{skuSheetVisible}}" class="sku-mask" bindtap="closeSkuSheet">
    <view class="sku-sheet" catchtap="noop">
      <view class="sku-handle"></view>

      <view class="sku-book">
        <image class="sku-cover" src="{{bookCover}}" mode="aspectFill" binderror="onBookCoverError" />
        <view class="sku-book-meta">
          <text class="sku-book-name">{{name}}</text>
          <text class="sku-book-stats">{{wordCountText}} 词 · {{proverbCountText}} 条句子 · {{totalText}} 个单元</text>
          <text wx:if="{{press}}" class="sku-book-press">{{press}}</text>
        </view>
        <view class="sku-close" catchtap="closeSkuSheet">✕</view>
      </view>

      <scroll-view scroll-y class="sku-body" enhanced show-scrollbar="{{false}}">
        <view class="sku-title">词典有效期</view>
        <view class="sku-options">
          <view
            wx:for="{{validityOptions}}"
            wx:key="id"
            class="sku-option {{selectedValidity === item.id ? 'sku-option-active' : ''}}"
            data-id="{{item.id}}"
            bindtap="selectValidity"
          >
            <view wx:if="{{selectedValidity === item.id}}" class="sku-tick">✓</view>
            <view class="sku-option-head">
              <text class="sku-option-name">{{item.name}}</text>
              <text wx:if="{{item.tag}}" class="sku-pill">{{item.tag}}</text>
            </view>
            <text class="sku-option-desc">{{item.summary}}</text>
          </view>
        </view>

        <view class="sku-title">套餐</view>
        <view class="sku-options">
          <view
            wx:for="{{packages}}"
            wx:key="id"
            class="sku-option {{selectedPackage === item.id ? 'sku-option-active' : ''}}"
            data-id="{{item.id}}"
            bindtap="selectPackage"
          >
            <view wx:if="{{selectedPackage === item.id}}" class="sku-tick">✓</view>
            <view class="sku-option-head">
              <text class="sku-option-name">{{item.name}}</text>
              <text wx:if="{{item.tag}}" class="sku-pill">{{item.tag}}</text>
            </view>
            <text class="sku-option-desc">{{item.summary}}</text>
          </view>
        </view>

        <view class="sku-includes">
          <view class="sku-includes-title">「{{currentPackage.name}}」包含</view>
          <view class="sku-includes-item" wx:for="{{currentPackageItems}}" wx:key="*this">
            <text class="sku-check">✓</text>
            <text class="sku-includes-text">{{item}}</text>
          </view>
        </view>
      </scroll-view>

      <view class="sku-actions">
        <view class="sku-foot-price">
          <text class="sku-foot-label">{{currentSku.skuLabel}}</text>
          <view class="sku-foot-amount-row">
            <text class="sku-foot-currency">¥</text>
            <text class="sku-foot-amount">{{currentSku.price}}</text>
          </view>
        </view>
        <view class="sku-confirm" bindtap="confirmPurchase">确认购买</view>
      </view>
    </view>
  </view>
</view>
