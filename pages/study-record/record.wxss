page {
  height: 100%;
  background: #fffdf8;
  color: #111318;
}

.study-record-page {
  height: 100%;
  overflow: hidden;
  background: linear-gradient(180deg, #fffdf8 0%, #f8fbf8 320rpx, #fffdf8 100%);
  font-family: PingFang SC, PingFangSC-Regular, sans-serif;
}

.record-nav-title {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111318;
  font-size: 32rpx;
  font-weight: 800;
  pointer-events: none;
}

.record-scroll {
  height: 100%;
  padding: 8rpx 31rpx 0;
  box-sizing: border-box;
}

.range-hero {
  padding: 32rpx;
  border-radius: 36rpx;
  background: linear-gradient(150deg, #1f344d 0%, #111318 100%);
  color: #ffffff;
  box-shadow: 0 18rpx 36rpx rgba(17, 19, 24, 0.18);
}

.range-hero-top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.range-hero-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.range-hero-art {
  flex: none;
  width: 136rpx;
  height: 136rpx;
  padding: 8rpx 10rpx 10rpx;
  border-radius: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.18);
  background: rgba(255, 255, 255, 0.09);
  box-sizing: border-box;
  overflow: visible;
}

.range-hero-mascot {
  width: 100%;
  height: 100%;
  display: block;
}

.range-main,
.panel-head,
.month-bar,
.trend-row,
.record-head {
  display: flex;
  align-items: center;
}

.range-main {
  justify-content: space-between;
  gap: 24rpx;
}

.range-title {
  color: #ffffff;
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 900;
  white-space: nowrap;
}

.range-minutes {
  flex: none;
  font-size: 64rpx;
  line-height: 66rpx;
  font-weight: 900;
}

.range-minutes {
  color: #4dd9a0;
}

.range-minutes text {
  margin-left: 4rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  font-weight: 700;
}

.range-period {
  align-self: flex-start;
  margin-top: 10rpx;
  padding: 4rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(77, 217, 160, 0.16);
  color: #4dd9a0;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 800;
  white-space: nowrap;
}

@keyframes recordRefreshA {
  0% { opacity: 0.4; transform: scale(0.98); }
  60% { opacity: 1; }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes recordRefreshB {
  0% { opacity: 0.4; transform: scale(0.98); }
  60% { opacity: 1; }
  100% { opacity: 1; transform: scale(1); }
}

.is-refreshed-a {
  animation: recordRefreshA 0.45s ease;
}

.is-refreshed-b {
  animation: recordRefreshB 0.45s ease;
}

.quick-row {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}

.quick-button {
  height: 52rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.76);
  background: rgba(255, 255, 255, 0.12);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.quick-button::after,
.panel-action::after,
.month-btn::after {
  border: 0;
}

.quick-button-active {
  color: #111318;
  background: #ffffff;
}

.panel {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #eef0f3;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(17, 19, 24, 0.05);
}

.panel-head {
  min-height: 48rpx;
  justify-content: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.panel-title {
  flex: 1;
  min-width: 0;
  color: #111318;
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.panel-action,
.panel-pill {
  flex: none;
  margin-left: auto;
  min-width: 0;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #168f3a;
  background: #f1fbf3;
  border: 1rpx solid rgba(22, 143, 58, 0.12);
  font-size: 22rpx;
  line-height: 44rpx;
  font-weight: 900;
}

.recent-range-shell,
.summary-grid,
.detail-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.recent-range-shell {
  display: block;
  padding: 8rpx 6rpx;
  border-radius: 28rpx;
  border: 2rpx solid #edf2ef;
  background: #fbfcfb;
}

.recent-strip {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 0;
}

.recent-day {
  position: relative;
  min-height: 104rpx;
  padding: 4rpx 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}

.recent-cell-inner,
.calendar-cell-inner {
  position: relative;
  z-index: 1;
  min-height: 88rpx;
  padding: 2rpx 0;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #5c6b7a;
  background: transparent;
  font-weight: 800;
  box-sizing: border-box;
}

.recent-week {
  position: absolute;
  top: 8rpx;
  left: 0;
  right: 0;
  text-align: center;
  color: #9aa3af;
  font-size: 18rpx;
  line-height: 22rpx;
}

.recent-day-today .recent-week {
  color: #ff8200;
  font-weight: 800;
}

.recent-date {
  margin-top: 2rpx;
  font-size: 24rpx;
  line-height: 28rpx;
}

.recent-minutes {
  position: absolute;
  bottom: 8rpx;
  left: 0;
  right: 0;
  text-align: center;
  color: #168f3a;
  font-size: 16rpx;
  line-height: 16rpx;
}

.recent-day-empty .recent-cell-inner {
  color: #b3bcc8;
  background: transparent;
}

.recent-cell-studied,
.calendar-cell-studied {
  min-height: 88rpx;
  margin: 0 5rpx;
  border-radius: 20rpx;
  color: #ffffff;
  background: linear-gradient(150deg, #263f45 0%, #111318 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 8rpx 16rpx rgba(17, 19, 24, 0.18);
}

.recent-cell-studied .recent-date,
.calendar-cell-studied .calendar-day-number {
  color: #ffffff;
  font-size: 28rpx;
  line-height: 32rpx;
}

.recent-cell-studied .recent-week,
.calendar-cell-studied .recent-week {
  color: rgba(255, 255, 255, 0.85);
}

.recent-week-label {
  color: #168f3a;
}

.recent-cell-studied .recent-week-label {
  color: #4dd9a0;
}

.recent-cell-studied .recent-minutes,
.calendar-cell-studied .calendar-day-minutes {
  color: rgba(255, 255, 255, 0.95);
}

.recent-cell-in-range,
.calendar-cell-in-range {
  background: transparent;
  color: #168f3a;
}

.recent-range-band,
.calendar-range-band {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  height: 88rpx;
  background: #e8f7ee;
  box-sizing: border-box;
  z-index: 0;
}

.recent-range-band-full,
.recent-range-band-from-center,
.recent-range-band-to-center,
.calendar-range-band-full,
.calendar-range-band-from-center,
.calendar-range-band-to-center {
  top: 50%;
  transform: translateY(-50%);
}

.recent-range-band-full,
.calendar-range-band-full {
  left: 0;
  right: 0;
}

.recent-range-band-from-center,
.calendar-range-band-from-center {
  left: 50%;
  right: 0;
}

.recent-range-band-to-center,
.calendar-range-band-to-center {
  left: 0;
  right: 50%;
}

.recent-range-band-round-left,
.calendar-range-band-round-left {
  border-top-left-radius: 34rpx;
  border-bottom-left-radius: 34rpx;
}

.recent-range-band-round-right,
.calendar-range-band-round-right {
  border-top-right-radius: 34rpx;
  border-bottom-right-radius: 34rpx;
}

.month-picker {
  padding: 12rpx 6rpx 4rpx;
  border-radius: 24rpx;
  background: #fbfcfb;
  border: 2rpx solid #edf2ef;
}

.month-bar {
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.month-title {
  flex: 1;
  text-align: center;
  white-space: nowrap;
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 800;
}

.month-btn {
  flex: none;
  width: 56rpx;
  min-width: 56rpx;
  height: 44rpx;
  padding: 0;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #168f3a;
  background: #f1fbf3;
  border: none;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 700;
}

.weekday-row,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 0;
}

.weekday {
  color: #9aa3af;
  font-size: 18rpx;
  line-height: 24rpx;
  text-align: center;
  padding-bottom: 6rpx;
}

.calendar-day {
  position: relative;
  min-height: 118rpx;
  padding: 4rpx 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}

.calendar-day-number {
  font-size: 24rpx;
  line-height: 26rpx;
}

.calendar-day-minutes {
  position: absolute;
  bottom: 8rpx;
  left: 0;
  right: 0;
  text-align: center;
  color: #168f3a;
  font-size: 16rpx;
  line-height: 16rpx;
}

.calendar-day-label {
  position: absolute;
  top: 8rpx;
  left: 0;
  right: 0;
  text-align: center;
  color: #168f3a;
  font-size: 16rpx;
  line-height: 18rpx;
  font-weight: 800;
  z-index: 2;
}

.calendar-day-label-edge {
  color: #4dd9a0;
}

.calendar-day-label-today {
  color: #ef9f27;
}

.calendar-day-today .calendar-day-number,
.recent-day-today .recent-date {
  width: 48rpx;
  height: 48rpx;
  margin-left: auto;
  margin-right: auto;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ff8200;
  border: 2rpx solid #ff8200;
}

.calendar-day-blank {
  background: transparent;
}

.recent-minutes,
.calendar-day-minutes {
  font-weight: 800;
}

.select-tip {
  margin: 18rpx 8rpx;
  padding: 16rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  color: #5a6b61;
  background: #f1f8f3;
  border: 1rpx solid #e2efe8;
  box-shadow: 0 6rpx 14rpx rgba(22, 143, 58, 0.05);
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 600;
}

.select-tip::before {
  content: '';
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #2bb35e;
}

.summary-item,
.detail-item {
  min-height: 148rpx;
  padding: 16rpx 14rpx 18rpx;
  border-radius: 30rpx;
  box-sizing: border-box;
  background: #fafbfc;
  border: 2rpx solid #eef0f3;
}

.summary-icon-box,
.detail-icon-box,
.trend-icon-box {
  width: 64rpx;
  height: 64rpx;
  margin: 0 auto 10rpx;
  padding: 6rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(17, 19, 24, 0.06);
  background: #ffffff;
  box-sizing: border-box;
}

.summary-icon,
.detail-icon,
.trend-icon {
  width: 100%;
  height: 100%;
}

.summary-value,
.detail-value {
  color: #111318;
  font-size: 36rpx;
  line-height: 42rpx;
  font-weight: 900;
  text-align: center;
}

.summary-label,
.detail-label {
  margin-top: 8rpx;
  color: #7a8798;
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
}

.trend-list {
  margin-top: 20rpx;
  display: grid;
  gap: 16rpx;
}

.trend-row {
  display: grid;
  grid-template-columns: 48rpx 116rpx 1fr 76rpx;
  gap: 10rpx;
  align-items: center;
  padding: 12rpx 14rpx;
  border-radius: 24rpx;
  border: 2rpx solid #eef0f3;
  background: #fafbfc;
  color: #66707a;
  font-size: 22rpx;
  line-height: 28rpx;
  box-sizing: border-box;
}

.trend-row .trend-icon-box {
  width: 48rpx;
  height: 48rpx;
  margin: 0;
  padding: 6rpx;
  border-radius: 16rpx;
}

.trend-label {
  white-space: nowrap;
  font-weight: 800;
  color: #111318;
}

.trend-track {
  height: 18rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #eef0f3;
  border: 1rpx solid rgba(17, 19, 24, 0.08);
}

.trend-fill {
  height: 100%;
  border-radius: 18rpx;
  background: #22c55e;
}

.trend-fill-read {
  background: #3f9581;
}

.trend-fill-quiz {
  background: #ffa11c;
}

.trend-fill-recite {
  background: #2f80ed;
}

.trend-value {
  text-align: right;
  font-weight: 800;
}

.record-day {
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid #eef0f3;
  box-shadow: 0 6rpx 16rpx rgba(17, 19, 24, 0.04);
}

.record-day:first-of-type {
  margin-top: 0;
}

.record-head {
  min-height: 108rpx;
  padding: 20rpx;
  gap: 20rpx;
}

.record-date {
  flex: none;
  width: 86rpx;
  height: 86rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: linear-gradient(150deg, #263f45 0%, #111318 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  font-weight: 900;
}

.record-month {
  color: rgba(255, 255, 255, 0.7);
  font-size: 18rpx;
  line-height: 22rpx;
}

.record-day-num {
  font-size: 34rpx;
  line-height: 36rpx;
}

.record-copy-box {
  flex: 1;
  min-width: 0;
}

.record-title {
  color: #111318;
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.record-sub {
  margin-top: 6rpx;
  color: #7a8798;
  font-size: 22rpx;
  line-height: 30rpx;
}

.record-arrow {
  flex: none;
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7a8798;
  background: #f4f5f7;
  border: 1rpx solid #eef0f3;
  font-size: 34rpx;
  line-height: 34rpx;
  transition: transform 0.16s ease;
}

.record-day-open .record-arrow {
  transform: rotate(90deg);
  color: #168f3a;
  background: #f1fbf3;
  border-color: #d8f0df;
}

.record-detail {
  margin: 0 20rpx;
  padding: 18rpx 0 22rpx;
  border-top: 1rpx solid #eef0f3;
}

.detail-grid {
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.detail-item {
  min-height: 120rpx;
  padding: 16rpx 14rpx;
  background: #fafbfc;
}

.detail-value {
  font-size: 30rpx;
  line-height: 36rpx;
}

.empty-record {
  padding: 34rpx 20rpx;
  border-radius: 30rpx;
  color: #7a8798;
  background: #fafbfc;
  border: 2rpx dashed #dde2e8;
  text-align: center;
  font-size: 26rpx;
  line-height: 36rpx;
}

.scroll-spacer {
  width: 100%;
}
