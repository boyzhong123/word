page {
  height: 100%;
  background: #fffdf8;
  color: #101010;
}

.plan-page {
  position: relative;
  height: 100%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: #fffdf8;
  font-family: PingFang SC, PingFangSC-Regular, sans-serif;
}

.plan-nav-title-wrap {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.plan-nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #101010;
}

/* 滚动区 */
.plan-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 29rpx;
  box-sizing: border-box;
}

/* 教材概览 */
.book-card {
  margin-top: 24rpx;
  padding: 22rpx 25rpx;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 27rpx;
  box-shadow: 0 8rpx 18rpx rgba(115, 91, 45, 0.06);
}

.book-cover {
  flex: none;
  width: 120rpx;
  height: 168rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
  box-shadow: 0 6rpx 8rpx rgba(169, 118, 14, 0.16);
}

.book-info {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
}

.book-name {
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 700;
}

.book-total {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #555555;
}

.book-total .hl {
  color: #111318;
  font-weight: 700;
}

.book-tip {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: #111318;
}

/* 通用区块 */
.section {
  margin-top: 24rpx;
  padding: 26rpx 25rpx 30rpx;
  background: #ffffff;
  border-radius: 27rpx;
  box-shadow: 0 8rpx 18rpx rgba(115, 91, 45, 0.055);
}

.section-title {
  font-size: 27rpx;
  font-weight: 700;
}

/* 每日数量 */
.daily-display {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stepper {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  line-height: 1;
  font-weight: 600;
  color: #111318;
  background: #ffffff;
  border: 2rpx solid #e3e5e9;
  border-radius: 50%;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(17, 19, 24, 0.1);
}

/* +/− 用 text 包一层，消除字形基线偏移导致的“不在圆心” */
.stepper-sign {
  display: block;
  line-height: 1;
}

.stepper-hover {
  background: #f3eff8;
}

.stepper-off {
  color: #cccccc;
  background: #f3f3f3;
  border-color: #ececec;
  box-shadow: none;
}

.daily-core {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.daily-mascot-icon {
  flex: none;
  width: 120rpx;
  height: 120rpx;
  transition: transform 0.2s ease;
}

.daily-mascot-icon-hard {
  transform: rotate(-3deg);
}

.daily-num {
  text-align: center;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.daily-num .num {
  display: inline-block;
  font-size: 76rpx;
  line-height: 80rpx;
  font-weight: 800;
  color: #101010;
  transform-origin: center center;
  /* 固定独立合成层：缩放动画只在该层重绘（真机更顺；模拟器仍有工具端整屏重绘瑕疵，可无视） */
  will-change: transform;
  transform: translateZ(0);
  backface-visibility: hidden;
}

/* 切换两个同效动画类来强制重启动画，实现数值变化时的轻微跳动 */
.daily-num .num-bump-a {
  animation: num-bump 0.18s ease-out;
}

.daily-num .num-bump-b {
  animation: num-bump 0.18s ease-out;
}

@keyframes num-bump {
  0% { transform: scale(1); }
  45% { transform: scale(1.06); }
  100% { transform: scale(1); }
}

.daily-num .unit {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: #888888;
}

.daily-hint {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #888888;
}

.daily-hint .hl {
  color: #111318;
  font-weight: 600;
}

/* 快捷预设 — 一体分段选择器 */
.preset-section {
  margin-top: 22rpx;
}

.preset-track {
  display: flex;
  align-items: stretch;
  padding: 6rpx;
  background: #f2f4f8;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.preset-seg {
  flex: 1;
  min-width: 0;
  padding: 14rpx 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  box-sizing: border-box;
  transition: background 0.18s ease, box-shadow 0.18s ease;
}

.preset-seg-hover {
  background: rgba(255, 255, 255, 0.45);
}

.preset-seg-active {
  background: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(91, 127, 214, 0.16);
}

.preset-seg-label {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  color: #8a9099;
}

.preset-seg-active .preset-seg-label {
  color: #2d4a8a;
  font-weight: 800;
}

.preset-seg-num {
  margin-top: 2rpx;
  font-size: 19rpx;
  line-height: 26rpx;
  color: #b0b5bd;
}

.preset-seg-active .preset-seg-num {
  color: rgba(45, 74, 138, 0.62);
  font-weight: 600;
}

/* 结果卡片 */
.result-card {
  margin-top: 24rpx;
  padding: 30rpx 0;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #f3eff8 0%, #eef4fd 100%);
  border: 2rpx solid #d5dff2;
  border-radius: 27rpx;
  box-sizing: border-box;
  box-shadow: 0 14rpx 30rpx rgba(91, 127, 214, 0.08);
}

.result-item {
  flex: 1;
  text-align: center;
}

.result-num {
  font-size: 50rpx;
  line-height: 56rpx;
  font-weight: 800;
  color: #111318;
}

.result-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #777777;
}

.result-divider {
  width: 1rpx;
  height: 56rpx;
  background: #e2e4e8;
}

/* 打卡规则预告 */
.checkin-card {
  margin-top: 24rpx;
  padding: 27rpx 25rpx 25rpx;
  background: #ffffff;
  border: 2rpx solid #d5dff2;
  border-radius: 27rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 18rpx rgba(91, 127, 214, 0.06);
}

.checkin-card-row {
  display: flex;
  align-items: center;
}

.checkin-card-icon {
  flex: none;
  width: 78rpx;
  height: 78rpx;
}

.checkin-card-copy-wrap {
  flex: 1;
  min-width: 0;
  margin-left: 21rpx;
}

.checkin-card-title {
  color: #101010;
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 800;
}

.checkin-card-title .hl {
  color: #5b7fd6;
}

.checkin-card-copy {
  margin-top: 7rpx;
  color: #777777;
  font-size: 23rpx;
  line-height: 34rpx;
}

.checkin-reward-pill {
  margin-top: 22rpx;
  padding: 16rpx 18rpx;
  display: flex;
  align-items: center;
  border: none;
  border-radius: 18rpx;
  box-sizing: border-box;
  background: #f3eff8;
}

.checkin-reward-icon {
  flex: none;
  width: 48rpx;
  height: 48rpx;
}

.checkin-reward-copy {
  flex: 1;
  margin-left: 15rpx;
  color: #2d4a8a;
  font-size: 23rpx;
  line-height: 32rpx;
  font-weight: 700;
}

/* 关卡预览 */
.level-list {
  margin-top: 20rpx;
}

.level-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f3f3f3;
}

.level-badge {
  flex: none;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #8aa4e8 0%, #5b7fd6 100%);
  border-radius: 50%;
  box-shadow: 0 6rpx 12rpx rgba(91, 127, 214, 0.18);
}

.level-info {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.level-name {
  font-size: 25rpx;
  font-weight: 600;
}

.level-range {
  margin-top: 5rpx;
  font-size: 21rpx;
  color: #999999;
}

.level-words {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 32rpx;
  color: #5f6872;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.level-words-loading {
  color: #9aa0a8;
}

.level-count {
  flex: none;
  font-size: 23rpx;
  font-weight: 500;
  color: #111318;
}

.level-more {
  padding: 22rpx 0 4rpx;
  text-align: center;
  font-size: 22rpx;
  color: #aaaaaa;
}

.level-more-action {
  color: #5b7fd6;
  font-weight: 700;
}

.scroll-spacer {
  height: 180rpx;
}

/* 底部保存 */
.footer {
  flex-shrink: 0;
  padding: 16rpx 29rpx 16rpx;
  background: rgba(255, 253, 248, 0.96);
  box-shadow: 0 -6rpx 16rpx rgba(115, 91, 45, 0.06);
}

.save-btn {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  background: #111318;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 18rpx rgba(17, 19, 24, 0.18);
}

.save-btn-hover {
  opacity: 0.85;
  transform: scale(0.99);
}

.save-btn-disabled {
  opacity: 0.55;
  box-shadow: none;
}
