page {
  height: 100%;
  background: #fbfaf5;
  color: #101010;
}

.sub-page {
  height: 100%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: #fbfaf5;
  font-family: PingFang SC, PingFangSC-Regular, sans-serif;
}

.nav-title {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  pointer-events: none;
}

.sub-scroll {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 18rpx 31rpx 0;
}

/* ---- 顶部邀请卡 ---- */
.invite-hero {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  color: #ffffff;
  box-shadow: 0 16rpx 36rpx rgba(47, 128, 237, 0.25);
}

.invite-hero-bg {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.invite-hero-overlay {
  position: absolute;
  z-index: 1;
  inset: 0;
  background:
    linear-gradient(115deg, rgba(22, 74, 165, 0.56) 0%, rgba(28, 98, 196, 0.28) 48%, rgba(47, 128, 237, 0.1) 100%),
    linear-gradient(0deg, rgba(20, 62, 130, 0.22), rgba(20, 62, 130, 0));
  pointer-events: none;
}

.invite-hero-body {
  position: relative;
  z-index: 2;
  padding: 40rpx 32rpx 32rpx;
}

.hero-kicker {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  opacity: 0.85;
}

.hero-title {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.4;
}

.hero-title + .hero-title {
  margin-top: 0;
}

.hero-sub {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  opacity: 0.9;
}

.hero-sub-em {
  font-weight: 800;
}

.code-card {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding: 22rpx 26rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
}

.code-copywrap {
  flex: 1;
  min-width: 0;
}

.code-label {
  font-size: 22rpx;
  opacity: 0.85;
}

.code-value {
  margin-top: 4rpx;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  font-family: Menlo, Consolas, monospace;
}

.code-copy-btn {
  flex: none;
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #2f80ed;
  font-size: 24rpx;
  font-weight: 800;
}

.code-copy-btn-hover {
  opacity: 0.85;
}

.hero-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 26rpx;
}

.hero-action {
  flex: 1;
  height: 88rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 800;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: 0 12rpx 28rpx rgba(16, 54, 115, 0.2);
}

.hero-action-poster {
  background: linear-gradient(180deg, #ffffff 0%, #f2f8ff 100%);
  color: #1f73df;
}

/* button 复位：转发按钮与普通视图按钮观感一致 */
.hero-action-share {
  margin: 0;
  padding: 0;
  line-height: 88rpx;
  background: linear-gradient(180deg, #29d592 0%, #11bd73 100%);
  color: #ffffff;
  border: 0;
  border-radius: 26rpx;
}

button.hero-action-share[plain] {
  color: #ffffff;
  border: 0;
}

.hero-action-share::after {
  border: none;
}

.hero-action-hover {
  opacity: 0.85;
}

/* ---- 卡片 ---- */
.invite-card {
  margin-top: 22rpx;
  padding: 26rpx 26rpx 10rpx;
  background: #ffffff;
  border: 1rpx solid rgba(240, 237, 229, 0.95);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(47, 96, 150, 0.045);
}

.invite-card-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 800;
  color: #111318;
}

.invite-card-note {
  font-size: 22rpx;
  font-weight: 400;
  color: #8b9098;
}

.inviter-row,
.invitee-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
}

.invitee-row + .invitee-row {
  border-top: 1rpx solid #f2f0ea;
}

.person-avatar {
  flex: none;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #f3f5f8;
}

.person-avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.person-copy {
  flex: 1;
  min-width: 0;
}

.person-name {
  font-size: 27rpx;
  font-weight: 700;
  color: #111318;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.person-meta {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8b9098;
}

.invite-badge {
  flex: none;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.invite-badge-success {
  background: #e6f9f0;
  color: #0fa968;
}

.invite-badge-pending {
  background: #fff4e5;
  color: #e8890c;
}

.invite-empty {
  padding: 18rpx 0 32rpx;
  text-align: center;
}

.invite-empty-art {
  width: 188rpx;
  height: 150rpx;
  margin: 2rpx auto 4rpx;
  display: block;
}

.invite-empty-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #5a6678;
}

.invite-empty-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #9aa3b5;
}

.invite-rules {
  margin-top: 22rpx;
  padding: 0 10rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: #9aa3b5;
}

.invite-rules-strong {
  font-weight: 700;
  color: #5a6678;
}

.scroll-spacer {
  height: 60rpx;
}

/* ---- 海报弹窗 ---- */
.poster-dialog-mask {
  position: fixed;
  z-index: 110;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(17, 19, 24, 0.66);
}

.poster-dialog {
  position: relative;
  width: 728rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.poster-swiper {
  width: 728rpx;
  height: 896rpx;
  margin-bottom: 16rpx;
}

.poster-theme-dots {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.poster-theme-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.34);
}

.poster-theme-dot-active {
  width: 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
}

.poster-frame {
  width: 560rpx;
  height: 896rpx;
  margin: 0 auto;
  border-radius: 24rpx;
  overflow: hidden;
  background: #2f80ed;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.3);
}

.poster-image {
  width: 560rpx;
  display: block;
}

.poster-loading {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.poster-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 14rpx;
  width: 600rpx;
}

.poster-action {
  flex: 1;
  margin: 0;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #ffffff;
  padding: 0;
}

.poster-action::after {
  border: none;
}

.poster-action-save {
  background: #ff9f43;
}

.poster-action-send {
  background: #19c37d;
}

.poster-action-hover {
  opacity: 0.85;
}

.poster-close {
  position: absolute;
  top: -76rpx;
  right: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.85);
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 离屏画布：仅用于导出海报图片 */
.invite-poster-canvas {
  position: fixed;
  top: -9999px;
  left: -9999px;
  width: 600px;
  height: 960px;
}
