/* pages/today/today.wxss */
.page {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: linear-gradient(180deg, #fff7e9 0%, #fffdf8 38%);
}

/* 参考成长页：scroll-view 承载滚动并隐藏右侧滚动条 */
.today-scroll {
  width: 100%;
  height: 100%;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.today-scroll::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  background: transparent;
}

.today-scroll-inner {
  box-sizing: border-box;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}
.page-vip-floating .today-scroll-inner {
  padding-bottom: calc(300rpx + env(safe-area-inset-bottom));
}

/* ===================== dashboard ===================== */
/* 顶部 hero 表头：满幅插画 + 昵称 + 标语，底部渐隐融入米色背景 */
.today-hero {
  position: relative;
  width: 100%;
}
.today-hero-img {
  display: block;
  width: 100%;
}
.today-hero-fade {
  position: absolute;
  z-index: 1;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 170rpx;
  background: linear-gradient(180deg, rgba(255, 247, 233, 0) 0%, rgba(255, 247, 233, 0.6) 62%, #fff7e9 100%);
  pointer-events: none;
}
.today-hero-copy {
  position: absolute;
  z-index: 2;
  top: 0;
  left: 40rpx;
  max-width: 440rpx;
}
.today-hero-eyebrow {
  margin-top: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #17406f;
  text-shadow:
    1rpx 0 0 rgba(255, 255, 255, 0.95),
    -1rpx 0 0 rgba(255, 255, 255, 0.95),
    0 1rpx 0 rgba(255, 255, 255, 0.95),
    0 -1rpx 0 rgba(255, 255, 255, 0.95);
}
.today-hero-title {
  margin-top: 6rpx;
  color: #0f3559;
  font-size: 46rpx;
  line-height: 58rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  text-shadow:
    1rpx 0 0 rgba(255, 255, 255, 0.95),
    -1rpx 0 0 rgba(255, 255, 255, 0.95),
    0 1rpx 0 rgba(255, 255, 255, 0.95),
    0 -1rpx 0 rgba(255, 255, 255, 0.95),
    1rpx 1rpx 0 rgba(255, 255, 255, 0.95),
    -1rpx 1rpx 0 rgba(255, 255, 255, 0.95),
    1rpx -1rpx 0 rgba(255, 255, 255, 0.95),
    -1rpx -1rpx 0 rgba(255, 255, 255, 0.95),
    0 2rpx 8rpx rgba(255, 253, 248, 0.85);
}
.today-hero-name-row {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
}
.today-hero-vip-badge {
  flex-shrink: 0;
  width: 90rpx;
  height: 36rpx;
  margin-left: 12rpx;
}
.today-hero-name {
  text-decoration: none;
}
.today-hero-name-ph {
  color: rgba(15, 53, 89, 0.78);
}
.today-hero-name-input {
  display: inline-block;
  width: 220rpx;
  height: 64rpx;
  min-height: 64rpx;
  color: #0f3559;
  font-size: 46rpx;
  line-height: 58rpx;
  font-weight: 800;
  vertical-align: top;
}
.today-hero-sub {
  margin-top: 8rpx;
  color: #17406f;
  font-size: 25rpx;
  line-height: 36rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  text-shadow:
    1rpx 0 0 rgba(255, 255, 255, 0.95),
    -1rpx 0 0 rgba(255, 255, 255, 0.95),
    0 1rpx 0 rgba(255, 255, 255, 0.95),
    0 -1rpx 0 rgba(255, 255, 255, 0.95);
}
/* 今日概览卡：负 margin 上浮压住 hero 草坪底部，把空白填掉 */
