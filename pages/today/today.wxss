}
.step-dot-completed .step-dot-icon,
.step-dot-upcoming .step-dot-icon {
  opacity: 0.96;
}

/* 当前步骤：唯一主操作 */
.spot {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 20rpx;
  padding: 24rpx 24rpx 20rpx;
  box-sizing: border-box;
  background: linear-gradient(155deg, #dcffec 0%, #ffffff 48%, #eefbf3 100%);
  border: 2rpx solid #22c55e;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(34, 197, 94, 0.16);
}
.spot-pin {
  position: absolute;
  top: -22rpx;
  right: -6rpx;
  width: 56rpx;
  height: 56rpx;
  z-index: 2;
  pointer-events: none;
}
.spot-copy {
  min-width: 0;
}
.spot-eyebrow-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}
.spot-eyebrow-pill {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  background: rgba(255, 154, 46, 0.16);
  border: 1rpx solid rgba(255, 122, 26, 0.28);
  border-radius: 999rpx;
}
.spot-eyebrow {
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 900;
  color: #e86a00;
  letter-spacing: 0.5rpx;
}
.spot-progress {
  flex: none;
  padding: 2rpx 14rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #199651;
  font-size: 20rpx;
  line-height: 30rpx;
  font-weight: 800;
  border-radius: 999rpx;
}
.spot-title {
  margin-top: 4rpx;
  font-size: 36rpx;
  line-height: 44rpx;
  font-weight: 900;
  color: #111318;
}
.spot-hint {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 32rpx;
  color: #66707a;
}
.spot-btn-wrap {
  position: relative;
  margin-top: 4rpx;
}
.spot-guide-finger {
  position: absolute;
  left: 58%;
  bottom: -2rpx;
  width: 0;
  height: 0;
  pointer-events: none;
  z-index: 2;
}
.spot-guide-finger-ring {
  position: absolute;
  left: 0;
  top: 0;
  width: 88rpx;
  height: 88rpx;
  margin: -58rpx 0 0 -44rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(34, 197, 94, 0.9);
  opacity: 0;
  animation: spot-guide-finger-ripple 1.8s ease-out infinite;
}
.spot-guide-finger-ring-2 {
  animation-delay: 0.9s;
}
.spot-guide-finger-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 68rpx;
  height: 68rpx;
  margin: 4rpx 0 0 -24rpx;
  transform: rotate(180deg);
  transform-origin: 50% 72%;
  animation: spot-guide-finger-press 1.8s ease-in-out infinite;
}
@keyframes spot-guide-finger-ripple {
  0% { transform: scale(0.45); opacity: 0.9; }
  70% { transform: scale(1.15); opacity: 0; }
  100% { transform: scale(1.15); opacity: 0; }
}
@keyframes spot-guide-finger-press {
  0%, 100% { transform: rotate(180deg) translateY(0) scale(1); }
  45% { transform: rotate(180deg) translateY(6rpx) scale(0.94); }
}
.spot-btn {
  width: 100%;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  border-radius: 999rpx;
}

.spot-btn-black {
  background: #111318;
  box-shadow: 0 10rpx 18rpx rgba(17, 19, 24, 0.18);
  animation: spot-btn-breathe-black 2.6s ease-in-out infinite;
}

.spot-btn-green {
  background: linear-gradient(135deg, #18b35f 0%, #0f9b4e 100%);
  box-shadow:
    0 10rpx 18rpx rgba(24, 179, 95, 0.24),
    0 0 0 6rpx rgba(98, 214, 139, 0.08);
  animation: spot-btn-breathe-green 2.6s ease-in-out infinite;
}

.spot-btn-teal {
  background: linear-gradient(135deg, #22c55e 0%, #38bdf8 100%);
  box-shadow: 0 10rpx 18rpx rgba(56, 189, 248, 0.22);
  animation: spot-btn-breathe-teal 2.6s ease-in-out infinite;
}

.spot-btn-pastel {
  background: linear-gradient(135deg, #ff9ecf 0%, #8ecbff 100%);
  box-shadow: 0 10rpx 18rpx rgba(142, 203, 255, 0.24);
  animation: spot-btn-breathe-pastel 2.6s ease-in-out infinite;
}

@keyframes spot-btn-breathe-black {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 10rpx 18rpx rgba(17, 19, 24, 0.18);
  }
  50% {
    transform: scale(1.02);
    box-shadow: 0 14rpx 26rpx rgba(17, 19, 24, 0.24);
  }
}

@keyframes spot-btn-breathe-green {
  0%, 100% {
    transform: scale(1);
    box-shadow:
      0 10rpx 18rpx rgba(24, 179, 95, 0.24),
      0 0 0 6rpx rgba(98, 214, 139, 0.08);
  }
  50% {
    transform: scale(1.02);
    box-shadow:
      0 14rpx 26rpx rgba(24, 179, 95, 0.32),
      0 0 0 12rpx rgba(98, 214, 139, 0.14);
  }
}

@keyframes spot-btn-breathe-teal {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 10rpx 18rpx rgba(56, 189, 248, 0.22);
  }
  50% {
    transform: scale(1.02);
    box-shadow: 0 14rpx 26rpx rgba(56, 189, 248, 0.3);
  }
}

@keyframes spot-btn-breathe-pastel {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 10rpx 18rpx rgba(142, 203, 255, 0.24);
  }
  50% {
    transform: scale(1.02);
    box-shadow: 0 14rpx 26rpx rgba(255, 158, 207, 0.28);
  }
}

/* 其它步骤：轻量预告 */
.step-row {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 72rpx;
  margin-top: 6rpx;
  padding: 12rpx 0;
  box-sizing: border-box;
}
.step-name {
  min-width: 0;
  color: #4b5560;
  font-size: 27rpx;
  line-height: 36rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.step-status {
  flex: none;
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #a6acb5;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 700;
}
.step-status-ico {
  font-size: 22rpx;
  line-height: 1;
}
.step-status-completed {
  color: #20a957;
}
.step-status-upcoming {
  color: #9aa3ad;
}

/* ===== 入门测推荐弹窗 ===== */
.entry-exam-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  background: rgba(20, 28, 38, 0.48);
}

.entry-exam-card {
  width: 100%;
  max-width: 620rpx;
  overflow: hidden;
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 22rpx 56rpx rgba(20, 28, 38, 0.24);
}

.entry-exam-hero {
  display: block;
  width: 100%;
  height: 320rpx;
}

.entry-exam-body {
  padding: 32rpx 36rpx 36rpx;
}

.entry-exam-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1a2430;
}

.entry-exam-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 38rpx;
  color: #6a7686;
}

.entry-exam-benefits {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.entry-exam-benefit {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #3a4654;
}

.entry-exam-dot {
  flex: none;
  width: 28rpx;
  color: #0f9b4e;
  font-weight: 800;
}

.entry-exam-actions {
  margin-top: 30rpx;
  display: flex;
  gap: 18rpx;
}

.entry-exam-btn {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.entry-exam-btn-ghost {
  box-sizing: border-box;
  color: #4a5564;
  background: #f1f4f8;
}

.entry-exam-btn-primary {
  color: #ffffff;
  background: linear-gradient(135deg, #18b35f 0%, #0f9b4e 100%);
  box-shadow: 0 10rpx 24rpx rgba(15, 155, 78, 0.28);
}

.entry-exam-btn-hover {
  opacity: 0.82;
}

/* ===== 再练确认弹窗（与成长页同款） ===== */
.reprac-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
  background: rgba(20, 28, 38, 0.45);
}
.reprac-card {
  width: 100%;
  box-sizing: border-box;
  padding: 40rpx 36rpx 32rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 18rpx 48rpx rgba(20, 28, 38, 0.22);
}
.reprac-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a2430;
}
.reprac-desc {
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 36rpx;
  color: #6a7686;
}
.reprac-strong {
  font-weight: 700;
  color: #0f9b4e;
}
.reprac-remind {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 6rpx 4rpx;
}
.reprac-remind-hover {
  opacity: 0.7;
}
.reprac-check {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9rpx;
  border: 2rpx solid #c7cedb;
  background: #ffffff;
}
.reprac-check-on {
  border-color: #111318;
  background: #111318;
}
.reprac-check-mark {
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1;
}
.reprac-remind-text {
  font-size: 23rpx;
  color: #6a7686;
}
.reprac-actions {
  margin-top: 30rpx;
  display: flex;
  gap: 20rpx;
}
.reprac-btn {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
}
.reprac-btn-ghost {
  box-sizing: border-box;
  color: #4a5564;
  background: #f1f4f8;
}
.reprac-btn-primary {
  color: #ffffff;
  background: #111318;
}
.reprac-btn-hover {
  opacity: 0.88;
}

.monster-hint {
  position: fixed;
  left: 0;
  right: 0;
  top: 58%;
  z-index: 1200;
  display: flex;
  justify-content: center;
  padding: 0 48rpx;
  box-sizing: border-box;
  pointer-events: none;
  transform: translateY(-50%);
}

.monster-hint-box {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  max-width: 100%;
  padding: 16rpx 26rpx 16rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 17, 0.85);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.1);
  animation: monster-hint-life 2s ease forwards;
}

.monster-hint-icon {
  width: 64rpx;
  height: 64rpx;
  display: block;
  flex: none;
}

.monster-hint-text {
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 400;
  color: #ffffff;
}

@keyframes monster-hint-life {
  0% {
    opacity: 0;
    transform: scale(0.92);
  }
  12% {
    opacity: 1;
    transform: scale(1);
  }
  82% {
    opacity: 1;
    transform: scale(1);
  }
  100% {
    opacity: 0;
    transform: scale(0.96);
  }
}
