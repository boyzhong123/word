  margin-top: 14rpx;
}
.seg-rail {
  position: absolute;
  left: 40rpx;
  top: 42rpx;
  bottom: 42rpx;
  width: 4rpx;
  background: #e1e4e8;
  border-radius: 2rpx;
}
.step {
  position: relative;
