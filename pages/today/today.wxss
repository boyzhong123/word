}
.inline-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  white-space: nowrap;
}
.ui-caret {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  box-sizing: border-box;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform-origin: 50% 50%;
}
.ui-caret-down {
  transform: rotate(45deg);
  margin-top: -4rpx;
}
.ui-caret-up {
  transform: rotate(225deg);
  margin-top: 4rpx;
}
.ui-caret-right {
  transform: rotate(-45deg);
  margin-left: -1rpx;
}
