<!--pages/exam/exam-report.wxml-->
<view class="report-page">
  <navigation background="transparent">
    <view class="report-nav-title">{{typeName}}</view>
  </navigation>

  <!-- 兜底：报告数据缺失时不至于纯白 -->
  <view wx:if="{{!result}}" class="report-empty">
    <view class="report-empty-text">暂未获取到测评成绩</view>
    <view class="report-empty-btn" bindtap="back">返回</view>
  </view>

  <scroll-view class="report-scroll" scroll-y enhanced show-scrollbar="{{false}}" wx:if="{{result}}">
    <!-- 顶部总览 -->
    <view class="hero">
      <view class="hero-art">
        <image class="hero-image" src="{{reportHeroSrc}}" mode="aspectFill" />
      </view>
      <view class="hero-content">
        <view class="hero-head">
          <text class="hero-kicker">{{typeName}}</text>
          <text class="hero-grade">{{grade}}</text>
        </view>
        <text class="hero-book">{{bookName || '本书'}}</text>
        <view class="hero-main">
          <view class="hero-score">
            <text class="hero-score-num">{{result.accuracy}}</text>
            <text class="hero-score-unit">%</text>
          </view>
          <view class="hero-meta">
            <text class="hero-meta-label">总正确率</text>
            <text class="hero-meta-value">答对 {{result.correct}}/{{result.total}} 题</text>
          </view>
        </view>
        <view class="hero-facts">
          <view wx:if="{{practiceTimeText}}" class="hero-fact">
            <text class="hero-fact-label">练习用时</text>
            <text class="hero-fact-value">{{practiceTimeText}}</text>
          </view>
          <view wx:if="{{practiceDateTimeText}}" class="hero-fact">
            <text class="hero-fact-label">练习时间</text>
            <text class="hero-fact-value">{{practiceDateTimeText}}</text>
          </view>
        </view>
        <view class="hero-encourage">
          <view class="hero-encourage-dot"></view>
          <text class="hero-encourage-text">{{encourage}}</text>
        </view>
      </view>
    </view>

    <!-- 结业测 vs 入门测 对比 -->
    <view class="section" wx:if="{{showCompare}}">
      <view class="section-title">
        <view class="section-bar"></view>
        <text class="section-title-main">入门 → 结业 对比</text>
      </view>

      <view wx:if="{{compareReady}}" class="compare-card">
        <view class="compare-row" wx:for="{{compares}}" wx:key="label">
          <view class="compare-side">
            <text class="compare-label">{{item.label}}</text>
            <view class="compare-delta compare-delta-{{item.trend}}">
              <text class="compare-delta-arrow" wx:if="{{item.trend === 'up'}}">▲</text>
              <text class="compare-delta-arrow" wx:elif="{{item.trend === 'down'}}">▼</text>
              <text class="compare-delta-arrow" wx:else>—</text>
              <text class="compare-delta-num">{{item.deltaText}}</text>
            </view>
          </view>
          <view class="compare-bars">
            <view class="compare-bar">
              <view class="compare-bar-fill compare-bar-entry" style="width: {{item.entry}}%;"></view>
              <text class="compare-bar-tag compare-bar-tag-entry">入门</text>
              <text class="compare-bar-val">{{item.entry}}%</text>
            </view>
            <view class="compare-bar">
              <view class="compare-bar-fill compare-bar-exit" style="width: {{item.exit}}%;"></view>
              <text class="compare-bar-tag">结业</text>
              <text class="compare-bar-val">{{item.exit}}%</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:else class="compare-empty">
        未找到入门测成绩，先完成入门测即可看到进步对比。
      </view>
    </view>

    <!-- 单词 / 句子 分项 -->
    <view class="section">
      <view class="section-title">
        <view class="section-bar"></view>
        <text class="section-title-main">分项表现</text>
      </view>
      <view class="seg-grid">
        <view class="seg-card seg-card-{{item.key}}" wx:for="{{sections}}" wx:key="key" style="background: {{item.tintBg}};">
          <view class="seg-head">
            <view class="seg-icon-box">
              <image class="seg-badge" src="{{item.icon}}" mode="aspectFit" />
            </view>
            <text class="seg-name">{{item.name}}</text>
            <text class="seg-pill" style="color: {{item.color}};">{{item.statusText}}</text>
          </view>
          <view class="seg-acc" style="color: {{item.color}};">{{item.accuracy}}<text class="seg-acc-unit">%</text></view>
          <view class="seg-track">
            <view class="seg-fill" style="width: {{item.accuracy}}%; background: {{item.color}};"></view>
          </view>
          <text class="seg-caption">答对 {{item.correct}}/{{item.total}}</text>
        </view>
      </view>
    </view>

    <!-- 题型掌握度 -->
    <view class="section">
      <view class="section-title">
        <view class="section-bar"></view>
        <text class="section-title-main">各题型掌握度</text>
      </view>
      <view class="type-list">
        <view class="type-row" wx:for="{{byType}}" wx:key="type">
          <view class="type-dot" style="background: {{item.barColor}};"></view>
          <text class="type-name">{{item.label}}</text>
          <view class="type-track">
            <view class="type-fill" style="width: {{item.accuracy}}%; background: {{item.barColor}};"></view>
          </view>
          <text class="type-val">{{item.correct}}/{{item.total}}</text>
        </view>
      </view>
    </view>

    <!-- 错题清单 -->
    <view class="section" wx:if="{{hasWrong}}">
      <view class="section-title">
        <view class="section-bar section-bar-warn"></view>
        <text class="section-title-main">待巩固</text>
        <text class="section-title-tag">{{result.wrongCount}} 题</text>
      </view>
      <view class="wrong-list">
        <view class="wrong-row" wx:for="{{wrong}}" wx:key="id">
          <view class="wrong-accent"></view>
          <view class="wrong-body">
            <view class="wrong-head">
              <text class="wrong-type">{{item.typeLabel}}</text>
              <text class="wrong-stem">{{item.stem}}</text>
            </view>
            <view class="wrong-answer">
              <text class="wrong-answer-label">答案</text>
              <text class="wrong-explain">{{item.explain}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="footer-space"></view>
  </scroll-view>

  <view class="action-bar" wx:if="{{result}}">
    <view class="action-btn action-btn-primary" bindtap="back">完成</view>
  </view>
</view>
