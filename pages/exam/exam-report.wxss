/* pages/exam/exam-report.wxss */
.report-page {
  min-height: 100vh;
  height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fffdf8 0%, #f7fbf8 340rpx, #fffdf8 100%);
  display: flex;
  flex-direction: column;
  color: #111318;
  font-family: PingFang SC, PingFangSC-Regular, sans-serif;
}

.report-nav-title {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
  color: #111318;
  pointer-events: none;
}

.report-scroll {
  flex: 1;
  height: 0;
  padding: 8rpx 31rpx 0;
  box-sizing: border-box;
}

.report-empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}

.report-empty-text {
  font-size: 28rpx;
  color: rgba(47, 67, 78, 0.5);
}

.report-empty-btn {
  padding: 18rpx 64rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #173f3a 0%, #123c46 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
}

/* 顶部总览 */
.hero {
  position: relative;
  min-height: 340rpx;
  margin: 0 0 24rpx;
  padding: 28rpx 28rpx 24rpx;
  box-sizing: border-box;
  overflow: hidden;
  color: #ffffff;
  border-radius: 36rpx;
  background: linear-gradient(150deg, #1f344d 0%, #111318 100%);
  box-shadow: 0 18rpx 36rpx rgba(17, 19, 24, 0.18);
}

.hero::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 92rpx;
  background: linear-gradient(180deg, rgba(77, 217, 160, 0) 0%, rgba(77, 217, 160, 0.08) 100%);
  pointer-events: none;
}

.hero-content {
  position: relative;
  z-index: 2;
}

.hero-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  padding-right: 196rpx;
}

.hero-kicker {
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: rgba(255, 255, 255, 0.74);
  font-size: 22rpx;
  line-height: 32rpx;
  font-weight: 800;
}

.hero-grade {
  flex: none;
  height: 40rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111318;
  background: #ffffff;
  border-radius: 22rpx;
  font-size: 22rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.hero-book {
  display: block;
  margin-top: 10rpx;
  max-width: 100%;
  padding-right: 196rpx;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #ffffff;
  font-size: 31rpx;
  line-height: 42rpx;
  font-weight: 900;
}

.hero-main {
  margin-top: 18rpx;
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
  min-width: 0;
  padding-right: 196rpx;
  box-sizing: border-box;
}

.hero-score {
  flex: none;
  display: flex;
  align-items: baseline;
}

.hero-score-num {
  color: #4dd9a0;
  font-size: 96rpx;
  font-weight: 900;
  line-height: 0.92;
}

.hero-score-unit {
  margin-left: 6rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 30rpx;
  font-weight: 800;
}

.hero-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
  padding-bottom: 8rpx;
}

.hero-meta-label {
  color: rgba(255, 255, 255, 0.64);
  font-size: 21rpx;
  line-height: 26rpx;
  font-weight: 800;
}

.hero-meta-value {
  color: #ffffff;
  font-size: 24rpx;
  line-height: 30rpx;
  font-weight: 900;
  white-space: nowrap;
}

.hero-facts {
  margin-top: 18rpx;
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  width: 100%;
}

.hero-fact {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 44rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: rgba(77, 217, 160, 0.1);
  border: 1rpx solid rgba(77, 217, 160, 0.18);
}

.hero-fact-label {
  flex: none;
  color: rgba(255, 255, 255, 0.62);
  font-size: 20rpx;
  line-height: 44rpx;
  font-weight: 700;
}

.hero-fact-value {
  flex: 1;
  min-width: 0;
  color: #4dd9a0;
  font-size: 21rpx;
  line-height: 44rpx;
  font-weight: 900;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hero-encourage {
  margin-top: 16rpx;
  width: 100%;
  min-height: 52rpx;
  padding: 10rpx 16rpx 10rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.hero-encourage-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #4dd9a0;
  box-shadow: 0 0 0 6rpx rgba(77, 217, 160, 0.12);
}

.hero-encourage-text {
  flex: 1;
  min-width: 0;
  color: rgba(255, 255, 255, 0.92);
  font-size: 22rpx;
  line-height: 32rpx;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hero-art {
  position: absolute;
  z-index: 1;
  right: 24rpx;
  top: 28rpx;
  width: 176rpx;
  height: 132rpx;
  border-radius: 22rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.18);
  box-shadow: 0 12rpx 22rpx rgba(0, 0, 0, 0.14);
  background: rgba(255, 255, 255, 0.08);
}

.hero-image {
  width: 100%;
  height: 100%;
  display: block;
}

/* 通用 section */
.section {
  margin: 28rpx 0 0;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
}

.section-bar {
  width: 8rpx;
  height: 30rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #34d39e, #1fb389);
}

.section-bar-warn {
  background: linear-gradient(180deg, #fbbf6b, #f97316);
}

.section-title-main {
  font-size: 31rpx;
  font-weight: 800;
  color: #111318;
  letter-spacing: 0;
}

.section-title-tag {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #f97316;
  background: #ffedd5;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

/* 对比卡 */
.compare-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 10rpx 24rpx;
  border: 1rpx solid #eef0f3;
  box-shadow: 0 8rpx 20rpx rgba(17, 19, 24, 0.05);
}

.compare-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 0;
  border-bottom: 2rpx solid #f1f3f6;
}

.compare-row:last-child {
  border-bottom: none;
}

.compare-side {
  width: 126rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.compare-label {
  font-size: 27rpx;
  font-weight: 900;
  color: #111318;
}

.compare-delta {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  gap: 2rpx;
  padding: 3rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.compare-delta-arrow {
  font-size: 18rpx;
}

.compare-delta-up {
  color: #15a06f;
  background: #e3f8ef;
}

.compare-delta-down {
  color: #ef4444;
  background: #fdecec;
}

.compare-delta-flat {
  color: #9aa0aa;
  background: #f1f3f6;
}

.compare-bars {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.compare-bar {
  position: relative;
  height: 42rpx;
  background: #edf2ef;
  border-radius: 999rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
}

.compare-bar-fill {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  border-radius: 999rpx;
}

.compare-bar-entry {
  background: #cbd7df;
}

.compare-bar-exit {
  background: linear-gradient(90deg, #34d39e, #1fb389);
}

.compare-bar-tag {
  position: relative;
  z-index: 1;
  margin-left: 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.95);
}

.compare-bar-tag-entry {
  color: #5b6670;
}

.compare-bar-val {
  position: relative;
  z-index: 1;
  margin-left: auto;
  margin-right: 16rpx;
  font-size: 21rpx;
  font-weight: 700;
  color: #3a4652;
}

.compare-empty {
  background: rgba(255, 255, 255, 0.96);
  border-radius: 28rpx;
  padding: 40rpx;
  border: 1rpx solid rgba(17, 19, 24, 0.06);
  text-align: center;
  font-size: 26rpx;
  color: #9aa0aa;
  line-height: 1.6;
}

/* 分项 */
.seg-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx;
}

.seg-card {
  position: relative;
  min-width: 0;
  overflow: hidden;
  border-radius: 32rpx;
  padding: 26rpx 24rpx 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 10rpx 26rpx rgba(17, 19, 24, 0.06);
}

.seg-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.seg-icon-box {
  flex: none;
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.56);
}

.seg-badge {
  flex: none;
  width: 52rpx;
  height: 52rpx;
}

.seg-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 800;
  color: #1d2b27;
}

.seg-pill {
  flex: none;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.82);
  font-size: 21rpx;
  line-height: 42rpx;
  font-weight: 800;
}

.seg-acc {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  font-size: 70rpx;
  font-weight: 900;
  line-height: 1;
}

.seg-acc-unit {
  margin-left: 4rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.seg-track {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  height: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 999rpx;
  overflow: hidden;
}

.seg-fill {
  height: 100%;
  border-radius: 999rpx;
}

.seg-caption {
  display: block;
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: rgba(47, 67, 78, 0.55);
}

/* 题型 */
.type-list {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 10rpx 28rpx;
  border: 1rpx solid #eef0f3;
  box-shadow: 0 8rpx 20rpx rgba(17, 19, 24, 0.05);
}

.type-row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 2rpx solid #eef2f4;
}

.type-row:last-child {
  border-bottom: none;
}

.type-dot {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 8rpx rgba(34, 197, 94, 0.08);
}

.type-name {
  width: 148rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  font-weight: 900;
  color: #1d2b27;
}

.type-track {
  flex: 1;
  height: 18rpx;
  background: #edf2ef;
  border-radius: 999rpx;
  overflow: hidden;
  margin: 0 18rpx;
}

.type-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.type-val {
  width: 72rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 800;
}

/* 错题 */
.wrong-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.wrong-row {
  display: flex;
  background: #ffffff;
  border-radius: 24rpx;
  border: 1rpx solid rgba(17, 19, 24, 0.06);
  box-shadow: 0 8rpx 24rpx rgba(76, 111, 180, 0.07);
  overflow: hidden;
}

.wrong-accent {
  flex: none;
  width: 8rpx;
  background: linear-gradient(180deg, #fbbf6b, #f97316);
}

.wrong-body {
  flex: 1;
  min-width: 0;
  padding: 24rpx 26rpx;
}

.wrong-head {
  display: flex;
  align-items: center;
}

.wrong-type {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #f97316;
  background: #fff1e3;
  padding: 3rpx 14rpx;
  border-radius: 999rpx;
  margin-right: 16rpx;
  font-weight: 700;
}

.wrong-stem {
  flex: 1;
  font-size: 27rpx;
  font-weight: 600;
  color: #111318;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.wrong-answer {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.wrong-answer-label {
  flex: none;
  font-size: 20rpx;
  font-weight: 700;
  color: #15a06f;
  background: #e3f8ef;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
}

.wrong-explain {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #2b6f5e;
  line-height: 1.5;
}

.footer-space {
  height: 60rpx;
}

/* 底部 */
.action-bar {
  padding: 16rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fffdf8;
  box-shadow: 0 -8rpx 24rpx rgba(76, 111, 180, 0.08);
}

.action-btn {
  height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}

.action-btn-primary {
  background: linear-gradient(135deg, #173f3a 0%, #123c46 100%);
  color: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(10, 24, 32, 0.2);
}
