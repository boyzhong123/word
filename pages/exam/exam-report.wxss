/* pages/exam/exam-report.wxss */
.report-page {
  min-height: 100vh;
  background: #f6f7fb;
  display: flex;
  flex-direction: column;
}

.report-nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111318;
}

.report-scroll {
  flex: 1;
  height: 0;
}

/* 顶部总览 */
.hero {
  margin: 12rpx 32rpx 0;
  padding: 40rpx 40rpx 48rpx;
  border-radius: 36rpx;
  background: linear-gradient(160deg, #16a34a 0%, #0f9d58 100%);
  color: #ffffff;
  box-shadow: 0 18rpx 40rpx rgba(22, 163, 74, 0.28);
}

.hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-book {
  font-size: 26rpx;
  opacity: 0.9;
}

.hero-grade {
  font-size: 24rpx;
  font-weight: 600;
  padding: 4rpx 20rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
}

.hero-score {
  margin-top: 24rpx;
  display: flex;
  align-items: baseline;
}

.hero-score-num {
  font-size: 110rpx;
  font-weight: 800;
  line-height: 1;
}

.hero-score-unit {
  font-size: 40rpx;
  font-weight: 700;
  margin-left: 8rpx;
}

.hero-score-label {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.92;
}

.hero-encourage {
  margin-top: 24rpx;
  padding: 18rpx 24rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

/* 通用 section */
.section {
  margin: 32rpx 32rpx 0;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title-main {
  font-size: 30rpx;
  font-weight: 700;
  color: #111318;
}

.section-title-tag {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #f97316;
  background: #ffedd5;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

/* 对比卡 */
.compare-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 12rpx 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(17, 19, 24, 0.05);
}

.compare-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f1f3f6;
}

.compare-row:last-child {
  border-bottom: none;
}

.compare-label {
  width: 96rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #111318;
}

.compare-bars {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.compare-bar {
  position: relative;
  height: 36rpx;
  background: #f1f3f6;
  border-radius: 999rpx;
  overflow: hidden;
}

.compare-bar-fill {
  height: 100%;
  border-radius: 999rpx;
}

.compare-bar-entry {
  background: #c7d2da;
}

.compare-bar-exit {
  background: #16a34a;
}

.compare-bar-val {
  position: absolute;
  left: 16rpx;
  top: 0;
  height: 36rpx;
  line-height: 36rpx;
  font-size: 20rpx;
  color: #4b5563;
}

.compare-delta {
  width: 96rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 22rpx;
  font-weight: 700;
}

.compare-delta-num {
  margin-left: 4rpx;
}

.compare-delta-up {
  color: #16a34a;
}

.compare-delta-down {
  color: #ef4444;
}

.compare-delta-flat {
  color: #9aa0aa;
}

.compare-empty {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #9aa0aa;
  line-height: 1.6;
}

/* 分项 */
.seg-grid {
  display: flex;
  gap: 24rpx;
}

.seg-card {
  flex: 1;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(17, 19, 24, 0.05);
}

.seg-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.seg-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #111318;
}

.seg-acc {
  font-size: 36rpx;
  font-weight: 800;
}

.seg-track {
  margin-top: 18rpx;
  height: 14rpx;
  background: #f1f3f6;
  border-radius: 999rpx;
  overflow: hidden;
}

.seg-fill {
  height: 100%;
  border-radius: 999rpx;
}

.seg-caption {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #9aa0aa;
}

/* 题型 */
.type-list {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 12rpx 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(17, 19, 24, 0.05);
}

.type-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f1f3f6;
}

.type-row:last-child {
  border-bottom: none;
}

.type-name {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #111318;
}

.type-track {
  flex: 1;
  height: 16rpx;
  background: #f1f3f6;
  border-radius: 999rpx;
  overflow: hidden;
  margin: 0 20rpx;
}

.type-fill {
  height: 100%;
  background: #16a34a;
  border-radius: 999rpx;
}

.type-val {
  width: 72rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 600;
}

/* 错题 */
.wrong-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.wrong-row {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(17, 19, 24, 0.04);
}

.wrong-head {
  display: flex;
  align-items: center;
}

.wrong-type {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #ef4444;
  background: #fee2e2;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  margin-right: 16rpx;
  font-weight: 600;
}

.wrong-stem {
  flex: 1;
  font-size: 26rpx;
  color: #111318;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.wrong-explain {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #16a34a;
  line-height: 1.5;
}

.footer-space {
  height: 60rpx;
}

/* 底部 */
.action-bar {
  padding: 16rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(17, 19, 24, 0.05);
}

.action-btn {
  height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}

.action-btn-primary {
  background: #16a34a;
  color: #ffffff;
}
