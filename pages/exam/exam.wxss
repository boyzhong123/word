/* pages/exam/exam.wxss —— 薄荷绿测评，呼应学习报告视觉 */
.exam-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #e9f9ef 0%, #f6f7fb 38%);
  display: flex;
  flex-direction: column;
}

.exam-nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111318;
}

/* ---------------- 开始页 ---------------- */
.intro {
  flex: 1;
  padding: 24rpx 40rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.intro-card {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(22, 163, 74, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.intro-mascot {
  width: 180rpx;
  height: 180rpx;
  margin-top: -110rpx;
}

.intro-title {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #111318;
}

.intro-subtitle {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.intro-total {
  margin-top: 24rpx;
  padding: 8rpx 28rpx;
  background: #dcfce7;
  color: #16a34a;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 999rpx;
}

.intro-sections {
  width: 100%;
  margin-top: 36rpx;
  display: flex;
  gap: 20rpx;
}

.intro-section {
  flex: 1;
  background: #f6f7fb;
  border-radius: 24rpx;
  padding: 24rpx;
}

.intro-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.intro-section-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #111318;
}

.intro-section-count {
  font-size: 24rpx;
  color: #16a34a;
  font-weight: 600;
}

.intro-section-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9aa0aa;
  line-height: 1.5;
}

.intro-tip {
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #9aa0aa;
}

.intro-btn {
  margin-top: 24rpx;
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  background: #16a34a;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(22, 163, 74, 0.28);
}

/* ---------------- 答题页 ---------------- */
.quiz-head {
  padding: 8rpx 40rpx 16rpx;
}

.progress-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.progress-track {
  flex: 1;
  height: 14rpx;
  background: #e5e7eb;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #16a34a;
  border-radius: 999rpx;
  transition: width 0.25s ease;
}

.progress-counter {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 600;
}

.quiz-tags {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.tag-section {
  background: #111318;
  color: #ffffff;
}

.tag-type {
  background: #dcfce7;
  color: #16a34a;
}

.quiz-body {
  flex: 1;
  padding: 12rpx 40rpx 0;
  box-sizing: border-box;
}

.stem-wrap {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 44rpx 36rpx;
  box-shadow: 0 10rpx 30rpx rgba(17, 19, 24, 0.05);
}

.stem-main {
  font-size: 44rpx;
  font-weight: 700;
  color: #111318;
  line-height: 1.45;
}

.stem-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.5;
}

.audio-stem {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.audio-btn {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #dcfce7;
  color: #16a34a;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.audio-hint {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #6b7280;
}

/* 选项 */
.options {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 2rpx solid #eceef2;
  border-radius: 24rpx;
  padding: 28rpx 28rpx;
  transition: all 0.15s ease;
}

.option-active {
  border-color: #16a34a;
  background: #f0fdf4;
}

.option-key {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f1f3f6;
  color: #6b7280;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.option-active .option-key {
  background: #16a34a;
  color: #ffffff;
}

.option-text {
  flex: 1;
  font-size: 30rpx;
  color: #111318;
  line-height: 1.4;
}

/* 连词成句 */
.order {
  margin-top: 24rpx;
}

.order-answer {
  min-height: 140rpx;
  background: #ffffff;
  border: 2rpx dashed #c7d6cb;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
  gap: 16rpx;
}

.order-answer-empty {
  align-items: center;
  justify-content: center;
}

.order-placeholder {
  font-size: 24rpx;
  color: #b6bcc6;
}

.order-bank {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  font-size: 30rpx;
  padding: 16rpx 28rpx;
  border-radius: 16rpx;
  line-height: 1.2;
}

.chip-answer {
  background: #16a34a;
  color: #ffffff;
}

.chip-bank {
  background: #ffffff;
  color: #111318;
  border: 2rpx solid #eceef2;
}

.chip-used {
  opacity: 0;
  pointer-events: none;
}

.quiz-body-space {
  height: 40rpx;
}

/* 底部操作 */
.quiz-foot {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: transparent;
}

.foot-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.foot-btn-ghost {
  background: #ffffff;
  color: #6b7280;
  border: 2rpx solid #e5e7eb;
}

.foot-btn-primary {
  background: #16a34a;
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(22, 163, 74, 0.26);
}

.foot-btn-mute {
  background: #b9d8c4;
  box-shadow: none;
}

.foot-btn-disabled {
  opacity: 0.5;
}
