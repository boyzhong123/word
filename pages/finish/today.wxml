<!--pages/finish/today.wxml-->
<view class='container' style="background-color: white;" wx:if="{{unitSort < unitCount}}">
  <image class="finish-header" src="{{headerImage}}" mode="widthFix" />
  <view class="content">{{stageTitle}}</view>
  <view class="sub-stepper">
    <block wx:for="{{subSteps}}" wx:key="type">
      <view wx:if="{{index > 0}}" class="sub-step-line {{item.lineState}}"></view>
      <view class="sub-step {{item.state}}">
        <view class="sub-step-dot">
          <text wx:if="{{item.state != 'upcoming'}}" class="sub-step-check">✓</text>
          <text wx:else>{{index + 1}}</text>
        </view>
        <view class="sub-step-label">{{item.label}}</view>
      </view>
    </block>
  </view>
  <view class="stage-summary-title">{{summaryTitle}}</view>
  <view class="stage-summary-sub">{{summarySub}}</view>
  <view class="checkin-progress-line">
    今日已完成 {{todayDone}}/{{todayGoal}} 关
    <text wx:if="{{overGoalCount > 0}}" class="checkin-progress-extra"> · 超额 {{overGoalCount}} 关</text>
  </view>
  <view class="checkin-success-card {{justCheckedIn ? 'checkin-success-card-bright' : ''}}" wx:if="{{checkinComplete}}">
    <image class="checkin-success-icon" src="../../images/checkin/charge-jelly.png" mode="aspectFit" />
    <view class="checkin-success-copy">
      <view class="checkin-success-title">{{justCheckedIn ? '打卡成功' : '今日已打卡'}}</view>
      <view class="checkin-success-subtitle">连续30天可领取礼品，去日历看看战绩。</view>
    </view>
    <view class="checkin-calendar-btn" bindtap="goCheckinCalendar">查看打卡日历</view>
  </view>
  <view wx:if="{{showContinue}}" class="btn" style="margin-top: {{checkinComplete ? 48 : 96}}rpx;" bindtap="continue">{{continueLabel}}</view>
  <view class="btn btn-secondary" style="margin-top: 40rpx;" bindtap="finish">完成</view>
</view>
<view class="box" wx:elif="{{unitSort == unitCount}}">
  <image class="head" src="https://17ks.chivoxapp.com/proverbs/finish_allbook_bg.png" mode="widthFix" />
  <image class="pic" src="https://17ks.chivoxapp.com/proverbs/finish_allbook.png" mode="widthFix" />
  <view class="info">
    <text style="font-size: 30rpx;color: #17324f;">恭喜你完成</text>
    <text style="font-size: 30rpx;color: #111318;">《{{bookname}}》</text>
    <view></view>
    <view class="column">
      <text class="num">{{wordnum}}</text>
      <text class="num2">词</text>
      <view class="type">词汇累计</view>
    </view>
    <view class="column">
      <text class="num">{{proverbnum}}</text>
      <text class="num2">条</text>
      <view class="type">谚语学习</view>
    </view>
  </view>
  <text class="btn" style="position: absolute;bottom: 100rpx;left: 66rpx;right: 66rpx;" bindtap="finish">太棒了</text>
</view>
