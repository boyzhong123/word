/* pages/finish/today.wxss */
.finish-header {
  display: block;
  width: 100%;
}

.content {
  text-align: center;
  font-size: 80rpx;
  font-family: OPPOSans;
  font-weight: bold;
  color: #111318;
}

/* 关卡环节步骤条：单词新学 → 跟读背诵 → 关卡小测 */
.sub-stepper {
  margin: 56rpx 70rpx 0;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.sub-step {
  flex: none;
  width: 150rpx;
  text-align: center;
}

.sub-step-dot {
  width: 56rpx;
  height: 56rpx;
  margin: 0 auto;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #9aa3ad;
  background: #eceff3;
  box-sizing: border-box;
  border: 2rpx solid #e1e5ea;
}

.sub-step-check {
  font-size: 30rpx;
  line-height: 1;
}

.sub-step.done .sub-step-dot {
  color: #ffffff;
  background: #16a34a;
  border-color: #16a34a;
}

.sub-step.current .sub-step-dot {
  color: #ffffff;
  background: #16a34a;
  border-color: #16a34a;
  box-shadow: 0 0 0 8rpx rgba(22, 163, 74, 0.16);
  animation: subStepPop 0.5s ease-out;
}

.sub-step-label {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #9aa3ad;
}

.sub-step.done .sub-step-label,
.sub-step.current .sub-step-label {
  color: #111318;
  font-weight: 600;
}

.sub-step-line {
  flex: 1;
  height: 6rpx;
  margin-top: 25rpx;
  border-radius: 999rpx;
  background: #e1e5ea;
}

.sub-step-line.done {
  background: #16a34a;
}

@keyframes subStepPop {
  0% {
    transform: scale(0.5);
    opacity: 0.4;
  }
  60% {
    transform: scale(1.18);
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.stage-summary-title {
  margin-top: 64rpx;
  font-size: 34rpx;
  font-family: PingFang SC;
  font-weight: 700;
  color: #111318;
  text-align: center;
  line-height: 48rpx;
}

.stage-summary-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: #62626b;
  text-align: center;
  line-height: 38rpx;
}

.checkin-progress-line {
  display: table;
  margin: 30rpx auto 0;
  padding: 12rpx 30rpx;
  background: #f3f4f6;
  border-radius: 999rpx;
  color: #62626b;
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 600;
  text-align: center;
}

.checkin-progress-extra {
  color: #c96a00;
}

.checkin-success-card {
  margin: 30rpx 66rpx 0;
  padding: 24rpx 24rpx 26rpx;
  display: flex;
  align-items: center;
  border-radius: 28rpx;
  background: #f5f3ff;
  box-shadow: 0 8rpx 18rpx rgba(124, 99, 255, 0.12);
}

.checkin-success-card-bright {
  background: linear-gradient(135deg, #ffffff, #f5f3ff);
}

.checkin-success-icon {
  flex: none;
  width: 78rpx;
  height: 78rpx;
}

.checkin-success-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.checkin-success-title {
  color: #1d1d22;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 800;
}

.checkin-success-subtitle {
  margin-top: 6rpx;
  color: #62626b;
  font-size: 22rpx;
  line-height: 32rpx;
}

.checkin-calendar-btn {
  flex: none;
  margin-left: 16rpx;
  padding: 13rpx 18rpx;
  color: #ffffff;
  background: #111318;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 700;
}

.btn {
  background: #111318;
  height: 100rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: bold;
  line-height: 100rpx;
  text-align: center;
  margin: 0 66rpx;
  box-shadow: 0 8rpx 18rpx rgba(17, 19, 24, 0.18);
}

.btn-secondary {
  background: #ffffff;
  color: #111318;
  border: 2rpx solid #e6e8ec;
  box-shadow: none;
}

.box {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  height: 100%;
  background-color: #2f80ed;
}

.pic {
  position: relative;
  width: calc(100% - 66rpx);
  margin: 180rpx 33rpx 0;
}

.head {
  position: fixed;
  width: 100%;
}

.info {
  border-radius: 30rpx;
  margin: -20rpx 40rpx 0;
  position: relative;
  background: white;
  padding: 93rpx 0 69rpx;
  box-shadow: 0 0 20rpx 0 rgba(0, 0, 0, 0.06);
  text-align: center;
  font-family: PingFang SC;
  font-weight: 500;
}

.column {
  display: inline-block;
  margin-top: 64rpx;
}

.num {
  font-size: 60rpx;
  color: #111318;
}

.num2 {
  font-size: 24rpx;
  color: #343434;
}

.type {
  margin: 30rpx 60rpx 0rpx;
  font-size: 36rpx;
  color: #343434;
}
