<view class="page">
  <navigation class="title-box" background="#fffdf8">
    <view class="vip-nav-title-wrap">
      <view class="vip-nav-title">确认订单</view>
    </view>
  </navigation>

  <view class="content">
    <!-- 商品信息 -->
    <view class="order-card">
      <view class="order-book">
        <image class="order-cover" src="{{bookCover}}" mode="aspectFill" />
        <view class="order-book-meta">
          <text class="order-book-name">{{name}}</text>
          <text wx:if="{{press}}" class="order-book-press">{{press}}</text>
          <view class="order-package-pill">{{orderPill || (packageName + ' · ' + validityName)}}</view>
        </view>
        <view class="order-price-col">
          <text class="order-price-currency">¥</text>
          <text class="order-price-value">{{price}}</text>
        </view>
      </view>
    </view>

    <!-- 兑换码 -->
    <view class="order-card redeem-card">
      <view class="redeem-row">
        <text class="redeem-label">兑换码</text>
        <block wx:if="{{!redeemApplied}}">
          <input
            class="redeem-input"
            type="text"
            placeholder="输入兑换码可抵扣"
            placeholder-class="redeem-placeholder"
            value="{{redeemInput}}"
            bindinput="onRedeemInput"
            confirm-type="done"
            disabled="{{paid}}"
          />
          <view class="redeem-btn" bindtap="applyRedeem">使用</view>
        </block>
        <block wx:else>
          <view class="redeem-applied">
            <text class="redeem-applied-code">{{appliedCode}}</text>
            <text class="redeem-applied-tag">已抵扣</text>
          </view>
          <view wx:if="{{!paid}}" class="redeem-remove" bindtap="removeRedeem">取消</view>
        </block>
      </view>
      <text wx:if="{{redeemError}}" class="redeem-error">{{redeemError}}</text>
    </view>

    <!-- 订单明细 -->
    <view class="order-card">
      <block wx:if="{{orderMode === 'membership'}}">
        <view class="order-row">
          <text class="order-row-label">会员类型</text>
          <text class="order-row-value">VIP 会员</text>
        </view>
        <view class="order-row">
          <text class="order-row-label">会员时长</text>
          <text class="order-row-value">{{validityName}}</text>
        </view>
      </block>
      <block wx:else>
        <view class="order-row">
          <text class="order-row-label">套餐</text>
          <text class="order-row-value">{{packageName}}</text>
        </view>
        <view class="order-row">
          <text class="order-row-label">有效期</text>
          <text class="order-row-value">{{validityName}}</text>
        </view>
      </block>
      <view class="order-row">
        <text class="order-row-label">支付方式</text>
        <text class="order-row-value">微信支付</text>
      </view>
      <view wx:if="{{redeemApplied}}" class="order-row">
        <text class="order-row-label">兑换码抵扣</text>
        <text class="order-row-value order-row-discount">-¥{{price}}</text>
      </view>
      <view class="order-divider"></view>
      <view class="order-row">
        <text class="order-row-label">合计</text>
        <view class="order-total">
          <text class="order-total-currency">¥</text>
          <text class="order-total-value">{{payPrice}}</text>
        </view>
      </view>
    </view>

    <view class="order-tip">
      <text class="order-tip-text">当前为测试环境，支付流程为模拟操作，不会产生真实扣款。</text>
    </view>
  </view>

  <view class="pay-bar" style="padding-bottom: {{safeAreaBottom}}px;">
    <view class="pay-amount">
      <text class="pay-amount-label">合计</text>
      <text class="pay-amount-currency">¥</text>
      <text class="pay-amount-value">{{payPrice}}</text>
    </view>
    <view wx:if="{{paid}}" class="pay-button pay-button-paid">已支付</view>
    <view wx:elif="{{redeemApplied}}" class="pay-button" bindtap="pay">0 元兑换</view>
    <view wx:else class="pay-button" bindtap="pay">立即支付</view>
  </view>
</view>
