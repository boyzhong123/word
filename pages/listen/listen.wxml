<view class="listen-page {{quizMode ? 'listen-quiz-shell' : pageAnimState}} {{pageSettled ? 'listen-page-settled' : ''}}">
  <!-- 小测：对齐新词学习页自定义导航 -->
  <block wx:if="{{quizMode}}">
    <view class="listen-quiz-nav">
      <navigation bindback="close" backInner="{{false}}" background="transparent">
        <view class="listen-nav-title-wrap">
          <view class="listen-nav-title-block">
            <view class="listen-nav-title">{{navTitle}}</view>
            <view wx:if="{{navSubtitle}}" class="listen-nav-subtitle">{{navSubtitle}}</view>
          </view>
        </view>
      </navigation>
      <view wx:if="{{quizQuestion && !quizAllDone}}" class="listen-quiz-top-progress">
        <view class="listen-quiz-top-progress-fill" style="width: {{quizProgressPercent}}%;"></view>
      </view>
    </view>
  </block>
  <!-- 随身听 -->
  <block wx:else>
    <view class="listen-nav">
      <navigation bindback="close" backInner="{{false}}" background="transparent" backIcon="icon_arrow_down.svg">
        <view class="listen-nav-title-wrap">
          <view class="listen-nav-title">{{unitName}}</view>
        </view>
      </navigation>
    </view>

    <!-- 页码指示：封面 / 课文 两页 -->
    <view wx:if="{{!loading}}" class="page-dots">
      <view class="page-dot {{currentPage == 0 ? 'page-dot-active' : ''}}"></view>
      <view class="page-dot {{currentPage == 1 ? 'page-dot-active' : ''}}"></view>
    </view>
  </block>

  <block wx:if="{{!loading && quizMode}}">
    <view class="quiz-page" style="padding-bottom: {{safeAreaBottom + 16}}px;">
      <view wx:if="{{quizAllDone}}" class="quiz-done-panel">
        <view class="quiz-done-card">
          <view class="quiz-done-title">关卡小测完成</view>
          <view class="quiz-done-copy">本关小测都做完啦，可以生成报告看看表现。</view>
        </view>
        <view class="quiz-report-btn" bindtap="openQuizReport">生成听力报告</view>
      </view>

      <block wx:elif="{{quizQuestion}}">
        <view class="quiz-body">
        <view wx:if="{{quizQuestion && !quizAllDone}}" class="quiz-step-row">
          <block wx:for="{{quizStepList}}" wx:key="key" wx:for-index="stepIndex">
            <view wx:if="{{stepIndex > 0}}" class="quiz-step-line"></view>
            <view class="quiz-step {{item.stepClass}}">
              <text class="quiz-step-no">{{item.no}}</text>
              <text class="quiz-step-label">{{item.label}}</text>
            </view>
          </block>
        </view>

        <view class="quiz-head">
          <view class="quiz-tip" wx:if="{{quizPhase === 'fill'}}">听音频，把缺的单词填进去</view>
          <view class="quiz-tip" wx:elif="{{quizPhase === 'spell'}}">听单词读音，选出缺失的字母</view>
          <view class="quiz-tip" wx:else>看着中文默念，然后开口背诵</view>
          <text wx:if="{{quizQuestion.page}}" class="quiz-page-tag">P{{quizQuestion.page}}</text>
        </view>

        <view class="quiz-card {{quizPhase === 'recite' ? 'quiz-card-recite' : ''}}">
          <view wx:if="{{quizPhase === 'recite' && quizReciteScore}}" class="quiz-score-badge">
            <text class="quiz-score-badge-text">{{quizReciteScore}}分</text>
          </view>

          <block wx:if="{{quizPhase === 'fill' && quizHasFill}}">
            <view class="quiz-guide">点击下方单词填空，点已填词可撤销</view>
            <view class="quiz-sentence">
              <block wx:for="{{quizQuestion.parts}}" wx:key="index">
                <text wx:if="{{item.type === 'text'}}">{{item.text}}</text>
                <text
                  wx:else
                  class="quiz-blank quiz-blank-{{item.status}}"
                  data-gap-index="{{item.gapIndex}}"
                  bindtap="onQuizBlankTap"
                >{{item.value || ' '}}</text>
              </block>
            </view>
            <view wx:if="{{quizQuestion.translation}}" class="quiz-translation">{{quizQuestion.translation}}</view>
            <view wx:if="{{quizResultText}}" class="quiz-result">{{quizResultText}}</view>
          </block>

          <block wx:elif="{{quizPhase === 'spell'}}">
            <view class="quiz-guide">点击下方字母块完成拼写</view>
            <view class="quiz-spell-word">
              <text>{{quizSpell.prefix}}</text>
              <text class="quiz-spell-gap {{quizSpellSelectedIndex == null ? '' : (quizSpellCorrect ? 'quiz-spell-gap-correct' : 'quiz-spell-gap-wrong')}}">{{quizSpellFilled || ' '}}</text>
              <text>{{quizSpell.suffix}}</text>
            </view>
            <view class="quiz-spell-ipa">
              <view class="quiz-spell-spk {{quizAudioPlaying ? 'quiz-spell-spk-playing' : ''}}" catchtap="playQuizSpellAudio">
                <image class="quiz-spell-spk-img" src="../../images/audio_small_hint.png" mode="aspectFit" />
              </view>
              <text wx:if="{{quizSpell.symbol}}" class="quiz-spell-symbol">{{quizSpell.symbol}}</text>
            </view>
            <view wx:if="{{quizSpell.translation}}" class="quiz-spell-cn">{{quizSpellSelectedIndex == null ? quizSpell.translation : (quizSpell.word + ' · ' + quizSpell.translation)}}</view>
            <view wx:if="{{quizSpellSelectedIndex != null}}" class="quiz-spell-verdict {{quizSpellCorrect ? 'quiz-spell-verdict-ok' : 'quiz-spell-verdict-no'}}">{{quizSpellCorrect ? '拼写正确' : ('正确答案：' + quizSpell.word)}}</view>
          </block>

          <block wx:else>
            <view class="quiz-guide">准备好后点击下方麦克风开始录音</view>
            <view class="quiz-recite-sentence">
              <block wx:for="{{quizReciteParts}}" wx:key="index">
                <text wx:if="{{item.type === 'text'}}">{{item.text}}</text>
                <text wx:else class="quiz-recite-blank" style="min-width: {{item.width * 18}}rpx;"> </text>
              </block>
            </view>
            <view wx:if="{{quizQuestion.translation}}" class="quiz-translation quiz-translation-recite">{{quizQuestion.translation}}</view>
          </block>
        </view>

        <view wx:if="{{quizPhase === 'recite'}}" class="quiz-recite-panel listen-full-bleed">
          <media
            wx:key="{{quizIndex}}"
            class="quiz-recite-media"
            _index="{{quizIndex}}"
            _autoplay="{{false}}"
            _audio="{{quizQuestion.audio}}"
            _refText="{{quizQuestion.reciteRefText || quizQuestion.sentence}}"
            _coreType="en.sent.score"
            score="{{quizReciteScore}}"
            bindresult="onQuizReciteResult"
            bindmediaStateChange="onQuizReciteStateChange"
            bindbeforeplay="onQuizMediaBeforePlay"
            bindunauthorized="onQuizReciteUnauthorized"
          ></media>
        </view>

        <view wx:if="{{quizPhase === 'fill' && quizHasFill}}" class="quiz-options">
          <view
            wx:for="{{quizQuestion.options}}"
            wx:key="index"
            class="quiz-option {{item.used ? 'quiz-option-used' : ''}}"
            data-index="{{index}}"
            bindtap="onQuizOptionTap"
          >
            {{item.text}}
          </view>
          <view
            wx:if="{{quizHasAnswers && !quizChecked}}"
            class="quiz-clear-btn"
            bindtap="onQuizClearAll"
          >清空</view>
        </view>

        <view wx:if="{{quizPhase === 'spell'}}" class="quiz-options quiz-spell-options">
          <view
            wx:for="{{quizSpell.options}}"
            wx:key="index"
            class="quiz-spell-opt {{quizSpellSelectedIndex != null && item.isAnswer ? 'quiz-spell-opt-correct' : ''}} {{quizSpellSelectedIndex == index && !item.isAnswer ? 'quiz-spell-opt-wrong' : ''}} {{quizSpellSelectedIndex != null && quizSpellSelectedIndex != index && !item.isAnswer ? 'quiz-spell-opt-muted' : ''}}"
            data-index="{{index}}"
            bindtap="onQuizSpellOptionTap"
          >{{item.text}}</view>
        </view>

        <view class="quiz-bottom-area">
          <view class="quiz-audio-hint" wx:if="{{quizPhase !== 'spell'}}" bindtap="replayQuizAudio">
            <view class="quiz-hint-btn {{quizAudioPlaying ? 'quiz-hint-btn-playing' : ''}}">
              <image class="quiz-hint-icon" src="../../images/word-new/hint-bulb.png" mode="aspectFit" />
            </view>
            <text class="quiz-hint-label">提示一下</text>
          </view>
          <view
            wx:if="{{quizNextCountdown > 0 && !quizNextPaused && (quizChecked || quizPhase === 'recite' || (quizPhase === 'spell' && quizSpellSelectedIndex != null))}}"
            class="quiz-countdown"
            catchtap="pauseQuizCountdown"
          >
            <text>{{quizNextCountdown}} 秒后{{quizNextIsSubmit ? '提交' : '进入下一步'}}，<text class="quiz-countdown-skip" catchtap="skipQuizNext">立即跳过</text></text>
            <text class="quiz-countdown-cancel">取消</text>
          </view>
          <view
            wx:elif="{{quizNextPaused && (quizChecked || quizPhase === 'recite' || (quizPhase === 'spell' && quizSpellSelectedIndex != null))}}"
            class="quiz-countdown"
            catchtap="resumeQuizNext"
          >
            <text>已暂停自动切换</text>
            <text class="quiz-countdown-go">{{quizNextIsSubmit ? '提交' : '进入下一步'}} ›</text>
          </view>
        </view>
        </view>
      </block>

      <view wx:else class="quiz-card quiz-empty">
        <view class="quiz-empty-title">本期暂无可测试例句</view>
        <view class="quiz-tip">可以先切换到其他关卡练习</view>
      </view>
    </view>
  </block>

  <block wx:elif="{{!loading}}">
  <!-- 主体：封面 / 课文 双页 -->
  <swiper class="stage" current="{{currentPage}}" bindchange="onSwiperChange" indicator-dots="{{false}}" duration="280">
    <!-- 第一页：封面 -->
    <swiper-item>
      <view class="cover-page">
        <view class="player-card" bindtap="{{listenGuideActive && listenGuideStep === 'swipe' ? 'noop' : 'togglePlay'}}">
          <view class="turntable">
            <image class="disc-tray" src="/images/listen/disc-tray.png" />
            <view class="disc-stack {{playing ? 'spinning' : ''}}">
              <image class="disc-texture" src="/images/listen/disc-texture-overlay.png" />
              <image class="cover-disc" src="{{bookCover}}" mode="aspectFill" binderror="onBookCoverError" />
              <view class="disc-sheen"></view>
            </view>
            <view class="disc-spindle"></view>
          </view>
          <view class="tonearm {{playing ? 'tonearm-on-disc' : ''}} {{tonearmInstant ? 'tonearm-instant' : ''}}">
            <image class="tonearm-img" src="/images/listen/tonearm-arm.png" />
          </view>
        </view>
        <view wx:if="{{!(listenGuideActive && listenGuideStep === 'swipe')}}" class="cover-hint">向左滑动可查看课文</view>
      </view>
    </swiper-item>

    <!-- 第二页：课文（单词列表） -->
    <swiper-item>
      <scroll-view class="lyrics" scroll-y scroll-top="{{scrollTop}}" scroll-with-animation catchtouchmove="{{followRecordingOverlay.active ? 'noop' : ''}}">
        <wxs src='/pages/paint.wxs' module="paintHandler"></wxs>
        <view class="lyrics-pad"></view>
        <view
          wx:for="{{tracks}}"
          wx:key="index"
          id="track-{{index}}"
          class="lyric-item lyric-{{item.type}} {{index == current ? 'lyric-active' : ''}} {{expandedIndex == index ? 'lyric-expanded' : ''}}"
          data-index="{{index}}"
          bindtap="onTrackTap"
        >
          <view class="lyric-head">
            <image
              class="lyric-tag"
              src="{{item.type == 'word' ? listenWordTagImage : listenSentenceTagImage}}"
              mode="aspectFit"
            />
            <view class="lyric-en">
              <block wx:if="{{trackScores[index] && trackScores[index].score != undefined && trackScores[index].score !== ''}}">
                <block wx:if="{{item.type == 'word'}}">
                  <text style="color: {{paintHandler.paintColor(trackScores[index])}}">{{item.content}}</text>
                </block>
                <block wx:else>
                  <text wx:for="{{paintHandler.splitText(item.content, trackScores[index].detail, item.exchange, item.wordContent, trackScores[index].score)}}" wx:for-index="tIndex" wx:for-item="text" wx:key="tIndex" class="{{text.class}}" style="{{text.style}}">{{text.value}}</text>
                  <image wx:if="{{paintHandler.containsTone(item.content)}}" src="https://17ks.chivoxapp.com/proverbs/rising_tone.png" class="lyric-tone" mode="aspectFit"></image>
                </block>
              </block>
              <block wx:else>{{item.content}}</block>
            </view>
          </view>
          <view wx:if="{{item.translation}}" class="lyric-cn">{{item.translation}}</view>

          <!-- 跟读测评：点击句子直接展开（样式对齐小测卡片） -->
          <view wx:if="{{expandedIndex == index}}" class="follow-panel" catchtap="noop">
            <view class="follow-card">
              <view class="follow-recite-panel">
                <media
                  class="follow-media"
                  _index="{{index}}"
                  _autoplay="{{true}}"
                  overlay-record="{{true}}"
                  _audio="{{item.audio}}"
                  _refText="{{item.refText || item.content}}"
                  _coreType="{{item.type == 'word' ? 'en.word.score' : 'en.sent.score'}}"
                  score="{{trackScores[index] && trackScores[index].score != undefined ? trackScores[index].score : ''}}"
                  bindresult="onMediaResult"
                  bindmediaStateChange="onMediaStateChange"
                  bindaudioEnd="onFollowMediaAudioEnd"
                  bindunauthorized="onMediaUnauthorized"
                ></media>
              </view>
            </view>
          </view>
        </view>
        <view class="lyrics-pad"></view>
      </scroll-view>
    </swiper-item>
  </swiper>

  <!-- 第一步滑动引导：独立全屏浮层，统一压暗整页 -->
  <view
    wx:if="{{listenGuideActive && listenGuideStep === 'swipe'}}"
    class="listen-guide-swipe-overlay"
  >
    <view class="listen-guide-swipe-dim"></view>
    <view class="listen-guide-swipe-content">
      <view class="listen-guide-swipe-stage">
        <image class="listen-guide-swipe-chev-img" src="/images/listen/listen-guide-swipe-chevrons-white.png" mode="aspectFit" />
        <view class="listen-guide-swipe-hand">
          <view class="listen-guide-swipe-trail"></view>
          <view class="listen-guide-swipe-trail listen-guide-swipe-trail-2"></view>
          <image class="listen-guide-swipe-hand-img" src="/images/listen/listen-guide-swipe-hand.png" mode="aspectFit" />
        </view>
      </view>
      <view class="listen-guide-coach listen-guide-coach-static">
        <image class="listen-guide-coach-mascot" src="/images/listen/listen-guide-coach-mascot.png" mode="aspectFit" />
        <view class="listen-guide-coach-bubble">
          <view class="listen-guide-coach-arrow"></view>
          <view class="listen-guide-coach-title">向左滑，看课文</view>
          <view class="listen-guide-coach-sub">滑到课文页，点句子就能跟读评分</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 跟读引导遮罩：聚光高亮 + 麦克风点按涟漪 + 吉祥物教练气泡（游戏化引导） -->
  <view
    wx:if="{{listenGuideActive && listenGuideStep === 'sentence' && listenGuideSpot.width > 0}}"
    class="listen-guide-mask"
  >
    <view
      class="listen-guide-spotlight listen-guide-spotlight-sentence"
      style="top: {{listenGuideSpot.top}}px; left: {{listenGuideSpot.left}}px; width: {{listenGuideSpot.width}}px; height: {{listenGuideSpot.height}}px;"
    ></view>
    <view
      class="listen-guide-coach listen-guide-coach-{{listenGuideSpot.placement}}"
      style="top: {{listenGuideSpot.calloutTop}}px;"
    >
      <image class="listen-guide-coach-mascot" src="/images/listen/listen-guide-coach-mascot.png" mode="aspectFit" />
      <view class="listen-guide-coach-bubble">
        <view class="listen-guide-coach-arrow"></view>
        <view class="listen-guide-coach-title">点这句，开始跟读</view>
        <view class="listen-guide-coach-sub">先点开这个句子，再听标准音开始练</view>
      </view>
    </view>
  </view>

  <view
    wx:if="{{listenGuideActive && (listenGuideStep === 'evaluate' || listenGuideStep === 'record') && listenGuideSpot.width > 0}}"
    class="listen-guide-mask"
  >
    <view
      class="listen-guide-spotlight"
      style="top: {{listenGuideSpot.top}}px; left: {{listenGuideSpot.left}}px; width: {{listenGuideSpot.width}}px; height: {{listenGuideSpot.height}}px;"
    ></view>
    <!-- 麦克风点按涟漪 + 手指 -->
    <view class="listen-guide-tap" style="left: {{listenGuideSpot.micX}}px; top: {{listenGuideSpot.micY}}px;">
      <view class="listen-guide-tap-ring"></view>
      <view class="listen-guide-tap-ring listen-guide-tap-ring-2"></view>
      <image class="listen-guide-tap-finger-img" src="/images/listen/listen-guide-tap-finger.png" mode="aspectFit" />
    </view>
    <!-- 吉祥物教练气泡 -->
    <view
      class="listen-guide-coach listen-guide-coach-{{listenGuideSpot.placement}}"
      style="top: {{listenGuideSpot.calloutTop}}px;"
    >
      <image class="listen-guide-coach-mascot" src="/images/listen/listen-guide-coach-mascot.png" mode="aspectFit" />
      <view class="listen-guide-coach-bubble">
        <view class="listen-guide-coach-arrow"></view>
        <view class="listen-guide-coach-title">{{listenGuideStep === 'record' ? '开始跟读吧！' : '先听一遍标准音'}}</view>
        <view class="listen-guide-coach-sub">{{listenGuideStep === 'record' ? '对着麦克风大声读，读完点波纹结束' : '听完标准音后，会自动开始录音'}}</view>
      </view>
    </view>
  </view>

  <!-- 第4步：录音授权引导（仅未授权时出现）。整层可点：拦截背景、按钮直接响应 -->
  <view
    wx:if="{{listenGuideActive && listenGuideStep === 'permission' && listenGuideSpot.width > 0}}"
    class="listen-guide-mask listen-guide-mask-interactive"
    catchtap="noop"
    catchtouchmove="noop"
  >
    <view
      class="listen-guide-spotlight"
      style="top: {{listenGuideSpot.top}}px; left: {{listenGuideSpot.left}}px; width: {{listenGuideSpot.width}}px; height: {{listenGuideSpot.height}}px;"
    ></view>
    <view
      class="listen-guide-coach listen-guide-coach-interactive listen-guide-coach-{{listenGuideSpot.placement}}"
      style="top: {{listenGuideSpot.calloutTop}}px;"
    >
      <image class="listen-guide-coach-mascot" src="/images/listen/listen-guide-coach-mascot.png" mode="aspectFit" />
      <view class="listen-guide-coach-bubble">
        <view class="listen-guide-coach-arrow"></view>
        <view class="listen-guide-coach-title">跟读需要麦克风</view>
        <view class="listen-guide-coach-sub">需要录下你的发音进行评分。点击「继续」后，请在系统弹窗中选择「允许」。</view>
        <view class="listen-guide-coach-btn" catchtap="onListenGuidePermissionAllow">继续</view>
      </view>
    </view>
  </view>

  <view
    wx:if="{{listenGuideActive && listenGuideStep === 'swipe'}}"
    class="listen-guide-controls-block"
    catchtap="noop"
    catchtouchmove="noop"
  ></view>

  <!-- 底部控制区 -->
  <view class="controls" style="padding-bottom: {{safeAreaBottom + 16}}px;">
    <!-- 整期进度条（覆盖本期所有单词+例句） -->
    <view class="seek-row">
      <view
        class="seek"
        catchtouchstart="onSeekStart"
        catchtouchmove="onSeekMove"
        catchtouchend="onSeekEnd"
      >
        <view class="seek-track">
          <view class="seek-fill" style="width: {{progress}}%;"></view>
        </view>
        <view class="seek-thumb" style="left: {{progress}}%;">
          <view class="seek-thumb-mascot">
            <image class="seek-thumb-mascot-frame seek-thumb-mascot-frame-1" src="../../images/listen/seek-thumb-mascot-1.png" mode="aspectFit" />
            <image class="seek-thumb-mascot-frame seek-thumb-mascot-frame-2" src="../../images/listen/seek-thumb-mascot-2.png" mode="aspectFit" />
            <image class="seek-thumb-mascot-frame seek-thumb-mascot-frame-3" src="../../images/listen/seek-thumb-mascot-3.png" mode="aspectFit" />
          </view>
        </view>
      </view>
      <view class="speed-badge" bindtap="toggleSpeed">{{speedLabel}}</view>
    </view>
    <view class="time-row">
      <text>{{current + 1}} / {{tracks.length}}</text>
      <text>{{currentTime}}</text>
    </view>

    <!-- 控制按钮 -->
    <view class="buttons">
      <view class="ctrl ctrl-loop" bindtap="toggleLoop">
        <image class="loop-icon" src="/images/listen/loop.svg" mode="aspectFit" />
        <view class="loop-label">{{loopLabel}}</view>
      </view>

      <view class="ctrl" bindtap="playPrev">
        <image class="ctrl-icon" src="/images/listen/prev.svg" mode="aspectFit" />
      </view>

      <view class="ctrl ctrl-play" bindtap="togglePlay">
        <image class="play-icon" src="{{playing ? '/images/listen/pause.svg' : '/images/listen/play.svg'}}" mode="aspectFit" />
      </view>

      <view class="ctrl" bindtap="playNext">
        <image class="ctrl-icon" src="/images/listen/next.svg" mode="aspectFit" />
      </view>

      <view class="ctrl" bindtap="openPlaylist">
        <image class="ctrl-icon" src="/images/listen/list.svg" mode="aspectFit" />
      </view>
    </view>
  </view>
  </block>

  <!-- 关卡切换面板：wx:if 卸载 DOM，避免 visibility:hidden 盖不住 scroll-view 子节点 -->
  <view wx:if="{{showPlaylist}}" class="sheet-mask sheet-show" bindtap="closePlaylist">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">选择关卡</text>
        <text class="sheet-count">共 {{units.length}} 关</text>
      </view>
      <scroll-view class="sheet-list" scroll-y>
        <view
          wx:for="{{units}}"
          wx:key="unitId"
          class="sheet-item {{index == unitIndex ? 'sheet-item-active' : ''}} {{!item.isUnlockedForListen ? 'sheet-item-locked' : ''}}"
          data-index="{{index}}"
          bindtap="onUnitTap"
        >
          <view class="sheet-item-main">
            <text class="sheet-item-name">{{'关卡' + (item.sort || index + 1)}}</text>
            <text wx:if="{{item.wordTotal}}" class="sheet-item-sub">{{item.wordTotal}} 词</text>
          </view>
          <view wx:if="{{!item.isUnlockedForListen || item.needVip}}" class="sheet-vip">会员</view>
          <view wx:elif="{{index == unitIndex}}" class="sheet-playing">播放中</view>
        </view>
      </scroll-view>
      <view class="sheet-close" bindtap="closePlaylist">关闭</view>
    </view>
  </view>

  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="loading">
    <view class="loading-panel">
      <view class="loading-mascot-wrap">
        <frame-animation
          url="{{loadingMascotSprite}}"
          count="6"
          width="160"
          height="160"
          duration="5.0"
          state="running"
        />
      </view>
      <view class="loading-title">{{quizMode ? '正在准备关卡小测' : '正在准备伴读'}}</view>
      <view class="loading-sub">{{quizMode ? '随机生成填空中' : '马上开始播放'}}</view>
    </view>
  </view>

  <dialog dialog="{{dialog}}"></dialog>
</view>

<!-- 录音波纹浮层挂在 listen-page 外：页面有 transform 入场动画时，内部 fixed 会错位 -->
<view
  wx:if="{{followRecordingOverlay.active}}"
  class="follow-recording-overlay follow-recording-overlay-root"
  style="top: {{followRecordingOverlay.top}}px; left: {{followRecordingOverlay.left}}px; width: {{followRecordingOverlay.width}}px; height: {{followRecordingOverlay.height}}px;"
  catchtap="onFollowRecordingOverlayTap"
>
  <wave-line wx:key="frw-{{followRecordingOverlay.waveSession}}" class="follow-recording-wave" />
  <text class="follow-recording-tip">点击波纹，结束录音</text>
</view>
