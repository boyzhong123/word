/* 组件默认 styleIsolation: isolated，app.wxss 的全局滚动条规则进不来，需组件内自定义 */
::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
}

.btn {
  position: relative;
  margin: 60rpx 36rpx 48rpx;
  background: #111318;
  height: 100rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 100rpx;
  text-align: center;
  box-shadow: 0 8rpx 18rpx rgba(17, 19, 24, 0.18);
}
