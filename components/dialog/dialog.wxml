<view class="dialog" wx:if="{{dialog.type == 'general'}}">
  <view class='dialog-bg'>
    <view class="dialog-title">{{dialog.title}}</view>
    <view class="dialog-content">{{dialog.content}}</view>
    <view wx:if="{{dialog.subtitle}}" class="dialog-subtitle">{{dialog.subtitle}}</view>
    <view class="dialog-button-container">
      <view class="dialog-button negetive" bindtap="onCancel">{{dialog.cancelText}}</view>
      <view class="dialog-button positive" bindtap="onConfirm">{{dialog.confirmText}}</view>
    </view>
  </view>
</view>
<view class="dialog" wx:elif="{{dialog.type == 'instruction'}}">
  <view class="dialog-bg guide-card">
    <view class="guide-header">
      <view class="guide-title">标记说明</view>
      <view class="guide-subtitle">读懂这几个标记，跟读和背诵更高效</view>
    </view>

    <!-- 页码标记 -->
    <view class="guide-section">
      <view class="guide-head">
        <text class="guide-badge">P1</text>
        <text class="guide-name">页码标记</text>
      </view>
      <view class="guide-text">对应实体书中该内容所在的页码/范围。第 1 页记作 <text class="guide-em">P1</text>，第 11~15 页记作 <text class="guide-em">P11~P15</text>。</view>
    </view>

    <!-- 句子标记 -->
    <view class="guide-section">
      <view class="guide-head">
        <text class="guide-icon">Aa</text>
        <text class="guide-name">句子标记</text>
      </view>
      <view class="guide-row">
        <text class="guide-key">加粗</text>
        <view class="guide-val">需要重读的单词，如 <text class="guide-bold">shortest</text></view>
      </view>
      <view class="guide-row">
        <text class="guide-key">升调</text>
        <view class="guide-val">句末需升调，如 <text class="guide-bold">升调</text><image src="../../images/rising_tone.png" class="guide-arrow" />；无标记则表示降调</view>
      </view>
    </view>

    <!-- 评分配色 -->
    <view class="guide-section">
      <view class="guide-head">
        <text class="guide-icon">★</text>
        <text class="guide-name">评分配色</text>
      </view>
      <view class="guide-row">
        <text class="guide-dot guide-dot-green"></text>
        <view class="guide-val"><text class="guide-strong" style="color:#3CC668;">绿色</text> 读得很好，智能评分 80 分以上</view>
      </view>
      <view class="guide-row">
        <text class="guide-dot guide-dot-gray"></text>
        <view class="guide-val"><text class="guide-strong">灰色</text> 读得一般，智能评分 60~80 分</view>
      </view>
      <view class="guide-row">
        <text class="guide-dot guide-dot-red"></text>
        <view class="guide-val"><text class="guide-strong" style="color:#FF6666;">红色</text> 读得不够好，智能评分低于 60 分</view>
      </view>
    </view>

    <text class="dialog-button positive guide-btn" bindtap="onConfirm">知道了</text>
  </view>
</view>
<view class="dialog" style="display: block;" wx:elif="{{dialog.type == 'vip'}}">
  <view class="dialog-bg go-vip-bg slide-bottom">
    <image src="/images/gray_close.png" class="close-img" bindtap="onCancel" />
    <view class="vip-tip">付费资源，开通会员后可查看</view>
    <view class="vip-btn" bindtap="onConfirm">开通会员</view>
  </view>
</view>